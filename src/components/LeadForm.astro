---
import { site } from '../data/site';
interface Props { heading?: string; sub?: string; }
const { heading = 'Get a free store audit', sub = 'Share your store or marketplace link. Within 24 hours you get a video walkthrough and a PDF with the fixes that will move sales fastest.' } = Astro.props;
---
<section class="section dark lf" id="audit">
  <div class="lf__glow" aria-hidden="true"></div>
  <div class="wrap lf__grid">
    <div class="lf__copy">
      <p class="eyebrow">Free audit · no obligation</p>
      <h2>{heading}</h2>
      <p class="lede">{sub}</p>
      <ul class="lf__list">
        <li>Speed & conversion leaks on your store</li>
        <li>Wasted spend in your Amazon / Meta / Google ads</li>
        <li>SEO & AI-search gaps vs your top 3 competitors</li>
      </ul>
      <p class="lf__alt">Prefer to talk? <a href={site.whatsapp} rel="noopener">WhatsApp us</a> or call <a href={site.phoneHref}>{site.phone}</a></p>
    </div>
    <form class="lf__form" action={site.formEndpoint} method="post">
      <input type="hidden" name="source" value="website-audit-form" />
      <label>Your name<input name="name" autocomplete="name" required /></label>
      <label>Work email<input name="email" type="email" autocomplete="email" required /></label>
      <label>WhatsApp number<input name="phone" type="tel" autocomplete="tel" inputmode="tel" required /></label>
      <label>Monthly online sales
        <select name="sales" required>
          <option value="">Select a range</option>
          <option>Just starting</option><option>Under ₹5 lakh</option><option>₹5–25 lakh</option><option>₹25 lakh – 1 crore</option><option>Above ₹1 crore</option>
        </select>
      </label>
      <label>Store / Amazon / website link<input name="store" type="url" placeholder="https://" required /></label>
      <label>Main need
        <select name="service">
          <option>Not sure — audit everything</option><option>New / better website</option><option>Amazon / Flipkart ads</option><option>Meta / Google ads</option><option>SEO & AI search</option>
        </select>
      </label>
      <button class="btn btn--primary" type="submit">Send my free audit request <span class="arrow" aria-hidden="true">↗</span></button>
      <p class="lf__note">We reply within one working day. No spam, ever.</p>
    </form>
  </div>
</section>
<style>
  .lf { position: relative; overflow: hidden; }
  .lf__glow { position: absolute; left: -10%; bottom: -40%; width: 60vw; height: 60vw; max-width: 760px; max-height: 760px; background: radial-gradient(closest-side, rgba(241,100,54,.4), transparent 70%); pointer-events: none; }
  .lf__grid { position: relative; display: grid; gap: 48px; align-items: start; }
  .lf__copy { display: grid; gap: 22px; }
  .lf__list { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .lf__list li::before { content: '✓'; color: var(--accent); font-weight: 700; margin-right: 10px; }
  .lf__alt { color: var(--muted-on-dark); }
  .lf__alt a { color: var(--white); }
  .lf__form { display: grid; gap: 14px; padding: clamp(22px, 3vw, 34px); border-radius: var(--radius); background: var(--white); color: var(--ink); box-shadow: var(--shadow); }
  .lf__form label { display: grid; gap: 6px; font-size: 14px; font-weight: 600; }
  .lf__form input, .lf__form select { width: 100%; min-height: 48px; padding: 0 14px; font: 400 16px var(--font-body); color: var(--ink); background: var(--paper); border: 1.5px solid var(--line); border-radius: var(--radius-sm); }
  .lf__form input:focus, .lf__form select:focus { outline: none; border-color: var(--accent); background: var(--white); }
  .lf__form .btn { margin-top: 6px; width: 100%; }
  .lf__form .btn:hover { background: var(--ink); color: var(--white); }
  .lf__note { font-size: 13px; color: var(--muted); text-align: center; }
  @media (min-width: 680px) { .lf__form { grid-template-columns: 1fr 1fr; } .lf__form label:nth-of-type(5), .lf__form label:nth-of-type(6), .lf__form .btn, .lf__note { grid-column: 1 / -1; } }
  @media (min-width: 980px) { .lf__grid { grid-template-columns: 1fr 1.1fr; gap: 72px; } }
</style>
