<section class="section prose-sec"><div class="wrap"><div class="prose"><slot /></div></div></section>
<style>
  .prose-sec { padding-top: 0; }
  .prose { max-width: 74ch; display: grid; gap: 16px; }
  .prose :global(h2) { font-size: clamp(1.5rem, 2.6vw, 2rem); margin-top: 24px; }
  .prose :global(h3) { font-size: 1.3rem; margin-top: 12px; }
  .prose :global(p), .prose :global(li) { color: #33373d; font-size: 1.05rem; line-height: 1.75; }
  .prose :global(ul), .prose :global(ol) { margin: 0; padding-left: 22px; display: grid; gap: 8px; }
  .prose :global(a) { color: var(--accent-ink); }
  .prose :global(table) { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; font-size: 15px; }
  .prose :global(th), .prose :global(td) { text-align: left; padding: 12px 14px; border-bottom: 1px solid var(--line); vertical-align: top; }
  .prose :global(th) { background: var(--accent-tint); font-weight: 600; }
  .prose :global(.table-wrap) { overflow-x: auto; }
  .prose :global(blockquote) { margin: 0; padding: 18px 22px; border-radius: 16px; background: var(--accent-tint); }
</style>
