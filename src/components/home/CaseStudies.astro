---
// EXAMPLE CONTENT — replace with real, client-approved results before launch.
const cases = [
  { client: 'Chennai Ayurveda brand', type: 'Shopify rebuild + Meta ads', metric: '3.1×', metricLabel: 'blended ROAS', note: 'Rebuilt product pages and checkout, launched creative testing on Meta.' },
  { client: 'Tiruppur apparel exporter', type: 'Amazon US + Shopify', metric: '+58%', metricLabel: 'monthly orders', note: 'Listing SEO, Sponsored Brands and a D2C store for repeat buyers.' },
  { client: 'South Indian snacks brand', type: 'E-commerce SEO + Blinkit ads', metric: '120+', metricLabel: 'keywords in top 10', note: 'Category-page content and quick-commerce launch in 4 cities.' },
];
---
<section class="section dark cs">
  <div class="wrap">
    <div class="section-head section-head--split">
      <div><p class="eyebrow">Case studies</p></div>
      <div class="cs__head">
        <h2>Growth you can measure.</h2>
        <a class="btn btn--ghost" href="/case-studies/">All case studies <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
    <ul class="cs__grid">
      {cases.map((c) => (
        <li class="cs__card">
          <div class="cs__top"><span class="example-badge">Example</span><span class="cs__type">{c.type}</span></div>
          <b class="cs__metric">{c.metric}</b>
          <span class="cs__mlabel">{c.metricLabel}</span>
          <h3>{c.client}</h3>
          <p>{c.note}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .cs__head { display: flex; flex-wrap: wrap; gap: 20px; align-items: end; justify-content: space-between; }
  .cs__grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .cs__card { display: grid; gap: 8px; align-content: start; padding: 28px; border-radius: var(--radius); background: var(--charcoal); border: 1px solid var(--line-dark); }
  .cs__top { display: flex; justify-content: space-between; gap: 10px; align-items: center; margin-bottom: 26px; color: var(--muted-on-dark); font-size: 13px; }
  .cs__metric { font-family: var(--font-display); font-stretch: 120%; font-size: clamp(3rem, 6vw, 4.4rem); line-height: 1; color: var(--accent); }
  .cs__mlabel { color: var(--muted-on-dark); margin-bottom: 18px; }
  .cs__card p { color: var(--muted-on-dark); font-size: 15px; }
  @media (min-width: 900px) { .cs__grid { grid-template-columns: repeat(3, 1fr); } }
</style>
