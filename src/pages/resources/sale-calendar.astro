const MK: Record<Mk, string> = { IN: 'India', UK: 'UK', US: 'US', UAE: 'UAE', AU: 'Australia' };
const FLAG: Record<Flag, string> = {
  moon: 'Expected: depends on moon sighting / official announcement',
  confirm: 'Lunar calendar: confirm closer to the date',
  tbc: 'Date to be confirmed',
  usually: 'Platform announces dates',
};
const DOW = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const MONTH_LONG = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const toDate = (s: string) => { const [y, m, d] = s.split('-').map(Number); return new Date(Date.UTC(y, m - 1, d)); };
const fmt = (d: Date, year = false) => `${d.getUTCDate()} ${MON[d.getUTCMonth()]}${year ? ' ' + d.getUTCFullYear() : ''}`;
const minus = (s: string, weeks: number) => new Date(toDate(s).getTime() - weeks * 7 * 864e5);

const rows = [...events].sort((a, b) => a.sort.localeCompare(b.sort)).map((e) => {
  const d = toDate(e.sort);
  const when = e.when ?? `${DOW[d.getUTCDay()]} ${fmt(d, true)}`;
  const day = e.exact || e.flag === 'confirm' || e.flag === 'moon' ? `${d.getUTCDate()}` : '';
  const ads = typeof e.ads === 'string' ? e.ads : `${e.ads[0]}–${e.ads[1]} weeks before` + (e.exact ? ` (from ${fmt(minus(e.sort, e.ads[1]))})` : e.flag === 'usually' ? ' the announced dates' : '');
  const prep = typeof e.prep === 'string' ? e.prep : `${e.prep} weeks before` + (e.exact ? ` (by ${fmt(minus(e.sort, e.prep))})` : '');
  return { month: e.sort.slice(0, 7), day, mon: MON[d.getUTCMonth()], when, flag: e.flag, flagText: e.flag ? FLAG[e.flag] : '', m: e.m, markets: e.m.map((k) => MK[k]).join(', '), event: e.event, why: e.why, ads, prep, date: e.exact ? e.sort : '' };
});
const months = [...new Set(rows.map((r) => r.month))].map((k) => ({ key: k, label: `${MONTH_LONG[+k.slice(5) - 1]} ${k.slice(0, 4)}`, rows: rows.filter((r) => r.month === k) }));
const csvRows = rows.map((r) => ({ m: r.m, cells: [r.date, r.when, r.markets, r.event, r.why, r.ads, r.prep, r.flagText || 'Fixed date'] }));

const trail = [{ label: 'Resources', href: '/resources/' }];
const guide = [
  { heading: 'How to use this ecommerce sale calendar', paragraphs: ['This ecommerce sale calendar covers November 2026 to December 2027 for the five markets we work in most: India, the UK, the US, the UAE and Australia. Each row gives the date (or the month, when a platform sets it), the markets it matters in, why it matters for an online store, when to start ads and when your preparation should be finished.', 'Use the market buttons to see only the dates that apply to you, then download the CSV and paste it into your planning sheet or project tool. The "start ads" and "prep by" dates are worked back from the event date, so you can drop them straight into a content calendar. Treat them as a starting point: a store with long delivery times or slow stock replenishment needs to start earlier.'] },
  { heading: 'Fixed dates, moon-based dates and platform sales', paragraphs: ['Not every date in a festive sale calendar is equally certain, and planning around the wrong day can waste a whole campaign. We mark three kinds of dates differently.', 'Fixed and calculated dates, such as Black Friday, Christmas, Boxing Day, Mothering Sunday and national days, are shown exactly. Hindu festivals follow the lunar calendar, and regional calendars sometimes differ by a day; we show the date most calendars give and mark it "confirm closer to the date". Ramadan and the two Eids depend on moon sighting and official announcements, so they are marked as expected dates that can move by a day or two.', 'Marketplace and shopping-festival dates (Flipkart Big Billion Days, Amazon Great Indian Festival, Prime Day, White Friday, Yellow Friday, Click Frenzy, the Dubai Shopping Festival) are announced by the platforms or organisers, usually a few weeks ahead. We show the month they usually fall in, never a guessed date. Watch seller emails and seller central notices for the real dates.'] },
  { heading: 'When to start ads before a sale', paragraphs: ['Ad platforms need time to learn who buys. If you switch on a new campaign the day before a sale, it competes in the most expensive auctions with no history and no warm audience. Starting earlier lets you test creatives while costs are lower, build a pool of engaged visitors for remarketing, and spend the peak days on people who already know you.', 'For the biggest peaks (Diwali, Black Friday, Christmas, Big Billion Days, Ramadan) start testing three to six weeks before and save most of the budget for the final week. For mid-sized gifting days such as Valentine\'s Day, Mother\'s Day and Raksha Bandhan, two to three weeks is usually enough. Check your break-even ROAS before the peak so you know how far you can raise bids and still make money.'], bullets: ['Test creatives and offers early, when ad costs are lower', 'Build remarketing audiences from video viewers, visitors and add-to-carts', 'Scale spend in the final week on the winners only', 'Keep a small budget running after the sale for late buyers and returns'] },
  { heading: 'What to prepare before every sale', paragraphs: ['Most sale problems are not ad problems. They are stock that runs out on day one, a discount code that does not work, a site that slows down under traffic, or a delivery promise the courier cannot keep. The "prep by" column is when these should be finished, not started.', 'Lock your offers and pricing first, because everything else depends on them. Then confirm stock and supplier lead times (remember Lunar New Year factory closures for anything sourced from China), brief creatives, test the site on mobile, and set delivery cut-off messages. Marketplace deals need extra time: Amazon, Flipkart and Noon close deal submissions well before the sale starts.'] },
  { heading: 'Peak seasons by market', paragraphs: ['India has two long peaks: the festive run from the big marketplace sales in late September through Navratri, Dussehra and Diwali, and a second wave of regional festivals through the year, from Pongal and Holi to Onam. Quick commerce matters for last-minute orders on festival days.', 'The UK, US and Australia share the Black Friday to Boxing Day peak, with Australia adding Click Frenzy and the EOFY sales in June. The UAE runs on a different rhythm: Ramadan and Eid al-Fitr, Eid al-Adha, White Friday and Yellow Friday, UAE National Day and the Dubai Shopping Festival. If you sell in more than one market, filter by each one and you will see where your team\'s busy weeks overlap.'] },
];
const faqs = [
  { q: 'When is Black Friday 2026 and 2027?', a: 'Black Friday is the day after US Thanksgiving, which falls on the fourth Thursday of November. In 2026 it is Friday 27 November, with Cyber Monday on 30 November. In 2027 Black Friday is Friday 26 November and Cyber Monday is 29 November.' },
  { q: 'When is Diwali 2027?', a: 'Most calendars place Diwali (Lakshmi Puja) on Friday 29 October 2027, with Dhanteras two days earlier on 27 October. Hindu festival dates follow the lunar calendar and regional calendars can differ by a day, so confirm the date in a local calendar before you fix delivery cut-offs.' },
  { q: 'When are Ramadan and Eid in 2027?', a: 'Ramadan is expected to start around 8 February 2027, Eid al-Fitr around 9 or 10 March and Eid al-Adha around 16 May. All three depend on moon sighting and official announcements, so they can move by a day or two. Plan campaigns around the expected window and adjust when dates are confirmed.' },
  { q: 'When are Flipkart Big Billion Days and Amazon Great Indian Festival?', a: 'Both are usually held in late September or early October, before Navratri, and run into the Diwali season. Flipkart and Amazon announce the exact dates themselves, usually a few weeks before. We do not list guessed dates; watch seller notices and plan your stock and deals as if the sale starts in late September.' },
  { q: 'How early should I start ads before a festive sale?', a: 'For major peaks such as Diwali, Black Friday or Christmas, start testing creatives and building audiences three to six weeks before, then put most of the budget into the final week. For smaller gifting days, two to three weeks is usually enough. Brands with long delivery times should start earlier.' },
  { q: 'Can I download this sale calendar?', a: 'Yes. Choose a market (or all markets) and press "Download CSV". The file includes the date, markets, event, why it matters, when to start ads and the prep deadline, and opens in Excel, Google Sheets or Numbers. Lunar, moon-sighting and platform dates are labelled so you know which to recheck.' },
];
const schema = [
  breadcrumbSchema([...trail, { label: 'Ecommerce Sale Calendar 2027', href: '/resources/sale-calendar/' }]),
  faqSchema(faqs),
  { '@context': 'https://schema.org', '@type': 'Article', headline: 'Ecommerce Sale Calendar 2027 for India, UK, US, UAE and Australia', description: 'Festive and sale dates from November 2026 to December 2027 with when to start ads and when to prepare.', url: `${site.url}/resources/sale-calendar/`, datePublished: '2026-10-22', dateModified: '2026-10-22', author: { '@id': `${site.url}/#org` }, publisher: { '@id': `${site.url}/#org` }, inLanguage: 'en-IN' },
];
const figures = [
  { type: 'mindmap', caption: 'The sale peaks that shape the year in each of the five markets.', after: 0, center: 'Sale peaks 2027', branches: [
    { label: 'India', items: ['Big Billion Days, Navratri', 'Diwali and Dhanteras', 'Pongal, Holi, Onam'] },
    { label: 'UK and US', items: ['Black Friday weekend', 'Christmas cut-offs', 'Mother\'s and Father\'s Day'] },
    { label: 'UAE', items: ['Ramadan and Eid', 'White and Yellow Friday', 'Dubai Shopping Festival'] },
    { label: 'Australia', items: ['Click Frenzy', 'EOFY in June', 'Boxing Day'] },
  ] },
  { type: 'steps', caption: 'A simple countdown for one big sale, from offers to the final push.', after: 2, steps: [
    { title: '8 weeks out', body: 'Lock offers, stock and supplier orders' },
    { title: '6 weeks out', body: 'Brief creatives, submit marketplace deals' },
    { title: '4 weeks out', body: 'Test ads, build remarketing audiences' },
    { title: 'Final week', body: 'Scale winners, show delivery cut-offs' },
    { title: 'After the sale', body: 'Retarget buyers, review profit' },
  ] },
];
const filters: { k: 'all' | Mk; label: string }[] = [{ k: 'all', label: 'All markets' }, { k: 'IN', label: 'India' }, { k: 'UK', label: 'UK' }, { k: 'US', label: 'US' }, { k: 'UAE', label: 'UAE' }, { k: 'AU', label: 'Australia' }];
---
<Base title="Ecommerce Sale Calendar 2027: Festive & Sale Dates | Magnus Path" description="Ecommerce sale calendar 2027 for India, UK, US, UAE and Australia: festive and marketplace sale dates, when to start ads and when to prep. Free CSV download." schema={schema}>
  <SimpleHero eyebrow="Free resource" h1="Ecommerce Sale Calendar 2027 for *India, UK, US, UAE and Australia*" intro="This ecommerce sale calendar 2027 lists every festive and shopping peak from November 2026 to December 2027, with when to start ads and when to finish preparing. Filter by market and download it as a CSV." trail={trail} current="Ecommerce Sale Calendar 2027" />

  <section class="section scal" id="calendar">
    <div class="wrap scal__wrap">
      <div class="scal__bar">
        <div class="scal__filters" role="group" aria-label="Filter by market">
          {filters.map((f, i) => <button type="button" class="scal__chip" data-k={f.k} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label}</button>)}
        </div>
        <button type="button" class="btn btn--primary btn--sm" id="scal-csv">Download CSV <span class="arrow" aria-hidden="true">↓</span></button>
      </div>
      <p class="scal__count" id="scal-count" aria-live="polite">Showing all {rows.length} dates, November 2026 to December 2027.</p>
      <ul class="scal__legend" aria-label="Date labels">
        <li><span class="scal__flag" data-f="confirm">Confirm</span> Lunar calendar: calendars can differ by a day</li>
        <li><span class="scal__flag" data-f="moon">Expected</span> Depends on moon sighting / official announcement</li>
        <li><span class="scal__flag" data-f="usually">Usually</span> Platform or organiser announces the dates</li>
        <li><span class="scal__flag" data-f="tbc">TBC</span> Date to be confirmed</li>
      </ul>

      {months.map((mo) => (
        <section class="scal__month" data-month={mo.key} aria-labelledby={`m-${mo.key}`}>
          <h2 id={`m-${mo.key}`}>{mo.label}</h2>
          <ul class="scal__list">
            {mo.rows.map((r) => (
              <li class="scal__row" data-m={r.m.join(' ')}>
                <div class="scal__when">
                  <span class="scal__day" aria-hidden="true">{r.day ? <>{r.day}<small>{r.mon}</small></> : <small>{r.mon}</small>}</span>
                  <span class="scal__date">{r.when}{r.flag && <span class="scal__flag" data-f={r.flag} title={r.flagText}>{{ moon: 'Expected', confirm: 'Confirm', tbc: 'TBC', usually: 'Usually' }[r.flag]}</span>}</span>
                </div>
                <div class="scal__what">
                  <h3>{r.event}</h3>
                  <p>{r.why}</p>
                  <p class="scal__mk"><span class="sr-only">Markets: </span>{r.m.map((k) => <span>{MK[k]}</span>)}</p>
                </div>
                <dl class="scal__plan">
                  <div><dt>Start ads</dt><dd>{r.ads}</dd></div>
                  <div><dt>Prep by</dt><dd>{r.prep}</dd></div>
                </dl>
              </li>
            ))}
          </ul>
        </section>
      ))}
      <p class="scal__empty" id="scal-empty" hidden>No dates for this market.</p>
      <div class="scal__cta">
        <p>Want help planning your next peak? Our team reviews your store, ads and offers before the sale.</p>
        <a class="btn btn--primary" href="/free-ecommerce-audit/?from=sale-calendar#audit">Get the full free audit <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <p class="scal__note">Dates checked on 22 October 2026. Lunar and moon-sighting dates can shift; platform sale dates are set by Amazon, Flipkart, Noon, Myntra, Click Frenzy and event organisers. Recheck each date a few weeks before you commit spend.</p>
    </div>
  </section>
  <script is:inline type="application/json" id="scal-data" set:html={JSON.stringify(csvRows)}></script>

  <FigureBand figure={figures[0] as any} n={1} />
  <Guide sections={guide} figures={figures.slice(1) as any} start={2} title="How to plan around the 2027 sale calendar" />
  <FAQ items={faqs} title="Sale calendar questions" />
  <Related links={[{ label: 'Performance marketing for e-commerce brands', href: '/performance-marketing/' }, { label: 'Amazon marketing agency', href: '/amazon-marketing-agency/' }, { label: 'ROAS & break-even ACoS calculator', href: '/tools/roas-calculator/' }, { label: 'UAE e-commerce marketing agency', href: '/uae/ecommerce-marketing-agency/' }, { label: 'Free e-commerce store audit', href: '/free-ecommerce-audit/' }]} />
  <LeadForm heading="Planning a big sale this year?" sub="Tell us which peak you are preparing for. We will review your store, ads and offers and send a prioritised list of fixes before the rush." />
</Base>

<script>
  type Row = { m: string[]; cells: string[] };
  const data = JSON.parse(document.getElementById('scal-data')!.textContent || '[]') as Row[];
  const names: Record<string, string> = { all: 'all markets', IN: 'India', UK: 'the UK', US: 'the US', UAE: 'the UAE', AU: 'Australia' };
  const chips = document.querySelectorAll<HTMLButtonElement>('.scal__chip');
  let current = 'all';
  try { const saved = localStorage.getItem('mp-sale-cal-market'); if (saved && saved in names) current = saved; } catch { /* storage blocked */ }

  function apply() {
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.k === current)));
    let shown = 0;
    document.querySelectorAll<HTMLElement>('.scal__month').forEach((mo) => {
      let n = 0;
      mo.querySelectorAll<HTMLElement>('.scal__row').forEach((r) => {
        const ok = current === 'all' || (r.dataset.m || '').split(' ').includes(current);
        r.hidden = !ok; if (ok) n++;
      });
      mo.hidden = n === 0; shown += n;
    });
    document.getElementById('scal-empty')!.hidden = shown > 0;
    document.getElementById('scal-count')!.textContent = `Showing ${shown} dates for ${names[current]}, November 2026 to December 2027.`;
  }
  chips.forEach((c) => c.addEventListener('click', () => {
    current = c.dataset.k || 'all';
    try { localStorage.setItem('mp-sale-cal-market', current); } catch { /* storage blocked */ }
    apply();
  }));

  const esc = (s: string) => (/[",\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s);
  document.getElementById('scal-csv')!.addEventListener('click', () => {
    const head = ['Date (YYYY-MM-DD)', 'When', 'Markets', 'Event', 'Why it matters', 'Start ads', 'Prep by', 'Date status'];
    const rows = data.filter((r) => current === 'all' || r.m.includes(current));
    const csv = '﻿' + [head, ...rows.map((r) => r.cells)].map((r) => r.map(esc).join(',')).join('\r\n');
    const url = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' }));
    const a = document.createElement('a');
    a.href = url; a.download = `ecommerce-sale-calendar-2027${current === 'all' ? '' : '-' + current.toLowerCase()}.csv`;
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  });
  apply();
</script>

<style>
  .scal { padding-top: clamp(20px, 3vw, 40px); }
  .scal__wrap { display: grid; gap: 18px; }
  .scal__bar { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between; background: var(--paper); padding: 10px 0; border-bottom: 1px solid var(--line); }
  @media (min-width: 760px) { .scal__bar { position: sticky; top: 76px; z-index: 5; } }
  .scal__filters { display: flex; flex-wrap: wrap; gap: 8px; }
  .scal__chip { font: 600 14px var(--font-body); padding: 9px 15px; border-radius: 999px; border: 1.5px solid var(--line); background: var(--white); color: var(--ink); cursor: pointer; }
  .scal__chip:hover { border-color: var(--ink); }
  .scal__chip[aria-pressed="true"] { background: var(--ink); border-color: var(--ink); color: var(--white); }
  .scal__chip:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .scal__count { font-size: 14px; color: var(--muted); }
  .scal__legend { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 20px; font-size: 13px; color: var(--muted); }
  .scal__legend li { display: inline-flex; align-items: center; gap: 8px; }
  .scal__flag { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; padding: 3px 8px; border-radius: 999px; background: #eef0f2; color: #33373d; white-space: nowrap; }
  .scal__flag[data-f="moon"] { background: #e6eef9; color: #1e3a8a; }
  .scal__flag[data-f="confirm"] { background: #fdf0d5; color: #7c4a03; }
  .scal__flag[data-f="usually"] { background: var(--accent-tint); color: var(--accent-ink); }
  .scal__flag[data-f="tbc"] { background: #f3e8ff; color: #6b21a8; }
  .scal__month { display: grid; gap: 10px; margin-top: 18px; scroll-margin-top: 150px; }
  .scal__month[hidden], .scal__row[hidden], .scal__empty[hidden] { display: none; }
  .scal__month h2 { font-size: clamp(1.4rem, 2.4vw, 1.9rem); }
  .scal__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .scal__row { display: grid; gap: 12px; padding: 18px; background: var(--white); border: 1px solid var(--line); border-radius: 20px; }
  .scal__when { display: flex; gap: 14px; align-items: flex-start; }
  .scal__day { flex: none; width: 54px; height: 54px; border-radius: 14px; background: var(--paper); border: 1px solid var(--line); display: grid; place-content: center; text-align: center; font-family: var(--font-display); font-weight: 600; font-size: 1.35rem; line-height: 1; font-variant-numeric: tabular-nums; }
  .scal__day small { display: block; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin-top: 3px; }
  .scal__date { display: grid; gap: 6px; justify-items: start; font-size: 14px; font-weight: 600; line-height: 1.4; }
  .scal__what { display: grid; gap: 6px; min-width: 0; }
  .scal__what h3 { font-size: 1.12rem; }
  .scal__what p { font-size: 15px; color: #33373d; line-height: 1.55; }
  .scal__mk { display: flex; flex-wrap: wrap; gap: 6px; }
  .scal__mk span:not(.sr-only) { font-size: 12px; font-weight: 600; padding: 3px 9px; border-radius: 999px; border: 1px solid var(--line); color: var(--muted); }
  .scal__plan { margin: 0; display: grid; gap: 8px; font-size: 14px; }
  .scal__plan div { display: grid; gap: 2px; }
  .scal__plan dt { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--accent-ink); }
  .scal__plan dd { margin: 0; color: #33373d; }
  .scal__empty { color: var(--muted); }
  .scal__cta { margin-top: 18px; display: flex; flex-wrap: wrap; gap: 16px; align-items: center; justify-content: space-between; padding: clamp(20px, 3vw, 30px); border-radius: 24px; background: var(--ink); color: var(--white); }
  .scal__cta p { max-width: 52ch; }
  .scal__note { font-size: 13px; color: var(--muted); max-width: 90ch; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  @media (min-width: 900px) {
    .scal__row { grid-template-columns: 240px 1fr 230px; gap: 24px; align-items: start; }
  }
  @media print {
    .scal__bar, .scal__cta { display: none; }
    .scal__row { break-inside: avoid; border-color: #ccc; }
  }
</style>
