---
interface Props { items: { title: string; body: string }[]; heading: string; }
const { items, heading } = Astro.props;
---
<section class="section pn">
  <div class="wrap">
    <div class="head"><p class="label" data-reveal>Sound familiar?</p><h2 data-reveal>{heading}</h2></div>
    <ul class="pn__grid">
      {items.map((p) => (
        <li class="pn__card" data-reveal>
          <svg class="pn__mesh" viewBox="0 0 120 120" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1"><circle cx="60" cy="60" r="48"/><ellipse cx="60" cy="60" rx="48" ry="18"/><ellipse cx="60" cy="60" rx="48" ry="34"/><ellipse cx="60" cy="60" rx="18" ry="48"/><ellipse cx="60" cy="60" rx="34" ry="48"/></g></svg>
          <h3>{p.title}</h3><p>{p.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .pn__grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .pn__card { display: grid; gap: 12px; align-content: start; padding: 28px; border-radius: var(--radius); background: var(--white); border: 1px solid var(--line); transition: background .4s var(--ease), color .4s var(--ease); }
  .pn__card:hover { background: var(--ink); color: var(--white); }
  .pn__card p { color: var(--muted); }
  .pn__card:hover p { color: var(--muted-on-dark); }
  .pn__mesh { width: 64px; color: #e7b9a3; margin-bottom: 8px; transition: transform .8s var(--ease), color .4s ease; }
  .pn__card:hover .pn__mesh { transform: rotate(40deg); color: var(--accent); }
  @media (min-width: 900px) { .pn__grid { grid-template-columns: repeat(3, 1fr); } }
</style>
