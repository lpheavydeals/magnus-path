---
interface Props { from: string; unit: string; note: string; items: string[]; heading: string; }
const { from, unit, note, items, heading } = Astro.props;
---
<section class="section pt">
  <div class="wrap pt__grid">
    <div class="head">
      <p class="label" data-reveal>Pricing</p>
      <h2 data-reveal>{heading}</h2>
      <p class="lede" data-reveal>{note}</p>
    </div>
    <div class="pt__card" data-reveal>
      <span class="pt__from">Starting from</span>
      <p class="pt__price">{from}<small>{unit}</small></p>
      <ul>{items.map((i) => <li>{i}</li>)}</ul>
      <div class="pt__ctas">
        <a class="btn btn--primary" href="/free-ecommerce-audit/">Get an exact quote <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href="/pricing/">See all pricing</a>
      </div>
    </div>
  </div>
</section>
<style>
  .pt__grid { display: grid; gap: 40px; align-items: center; }
  .pt__grid .head { margin: 0; }
  .pt__card { display: grid; gap: 16px; padding: clamp(26px, 3.5vw, 44px); border-radius: 30px; background: linear-gradient(140deg, #fff 0%, #fff1ea 60%, #ffd9c6 100%); border: 1px solid #ffe2d3; box-shadow: var(--shadow); }
  .pt__from { font-size: 14px; color: var(--muted); }
  .pt__price { font-family: var(--font-display); font-weight: 500; letter-spacing: -0.04em; font-size: clamp(2.8rem, 5vw, 4.2rem); line-height: 1; display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .pt__price small { font-family: var(--font-body); font-size: 1rem; letter-spacing: 0; color: var(--muted); font-weight: 500; }
  .pt__card ul { list-style: none; padding: 0; margin: 6px 0; display: grid; gap: 10px; }
  .pt__card li::before { content: '+'; color: var(--accent); font-weight: 700; margin-right: 10px; }
  .pt__ctas { display: flex; flex-wrap: wrap; gap: 10px; }
  @media (min-width: 980px) { .pt__grid { grid-template-columns: 1fr 1fr; gap: 80px; } }
</style>
