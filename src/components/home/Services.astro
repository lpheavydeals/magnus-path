---
const pillars = [
  {
    n: '01', name: 'E-commerce Websites', href: '/ecommerce-website-development/',
    lead: 'Fast, conversion-focused stores that are easy to run.',
    points: ['Shopify & Shopify Plus stores', 'WooCommerce & custom builds', 'UPI, COD, GST invoices, shipping integrations', 'Speed under 2 seconds, SEO-ready from day one'],
    links: [['Shopify Development', '/shopify-development/'], ['WooCommerce Development', '/woocommerce-development/']],
  },
  {
    n: '02', name: 'E-commerce Ads', href: '/performance-marketing/',
    lead: 'Profitable ads on every channel your buyers use.',
    points: ['Amazon Sponsored Products, Brands & Display', 'Flipkart PLA & brand ads', 'Meta & Google Shopping / Performance Max', 'Blinkit, Zepto & Instamart ads'],
    links: [['Amazon Advertising', '/amazon-marketing-agency/'], ['Amazon Account Management', '/amazon-account-management/'], ['Flipkart Account Management', '/flipkart-account-management/']],
  },
  {
    n: '03', name: 'E-commerce SEO', href: '/ecommerce-seo/',
    lead: 'Rankings that keep bringing orders after the ad budget stops.',
    points: ['Technical SEO & Core Web Vitals', 'Category & product page content', 'Amazon & Flipkart listing SEO', 'AI search (GEO): get cited by ChatGPT & Google AI'],
    links: [['Shopify SEO', '/shopify-seo/'], ['Amazon SEO', '/amazon-seo/'], ['SEO Packages', '/ecommerce-seo-packages/']],
  },
];
---
<section class="section dark sv" id="services">
  <div class="wrap">
    <div class="section-head section-head--split">
      <div><p class="eyebrow">Services</p></div>
      <h2>Take a look at what we offer.</h2>
    </div>
    <div class="sv__list">
      {pillars.map((p) => (
        <article class="sv__row">
          <div class="sv__left">
            <span class="sv__n">{p.n}</span>
            <h3><a href={p.href}>{p.name}</a></h3>
            <p>{p.lead}</p>
          </div>
          <ul class="sv__points">{p.points.map((pt) => <li>{pt}</li>)}</ul>
          <div class="sv__links">
            {p.links.map(([l, h]) => <a href={h}>{l} <span aria-hidden="true">↗</span></a>)}
            <a class="btn btn--primary" href={p.href}>Explore {p.name.replace('E-commerce ', '')} <span class="arrow" aria-hidden="true">→</span></a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
<style>
  .sv__list { display: grid; gap: 16px; }
  .sv__row { display: grid; gap: 28px; padding: clamp(24px, 3vw, 40px); border-radius: var(--radius); background: var(--charcoal); border: 1px solid var(--line-dark); transition: border-color .25s ease; }
  .sv__row:hover { border-color: var(--accent); }
  .sv__left { display: grid; gap: 12px; align-content: start; }
  .sv__n { font-size: 14px; font-weight: 600; color: var(--accent); }
  .sv__left h3 { font-size: clamp(1.6rem, 2.8vw, 2.2rem); }
  .sv__left h3 a { text-decoration: none; }
  .sv__left h3 a:hover { color: var(--accent); }
  .sv__left p { color: var(--muted-on-dark); }
  .sv__points { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; align-content: start; }
  .sv__points li { padding-left: 26px; position: relative; }
  .sv__points li::before { content: ''; position: absolute; left: 0; top: .55em; width: 12px; height: 12px; border: 2px solid var(--accent); transform: rotate(45deg); }
  .sv__links { display: grid; gap: 10px; align-content: start; }
  .sv__links a:not(.btn) { color: var(--muted-on-dark); text-decoration: none; font-size: 15px; border-bottom: 1px solid var(--line-dark); padding-bottom: 10px; display: flex; justify-content: space-between; }
  .sv__links a:not(.btn):hover { color: var(--accent); }
  .sv__links .btn { margin-top: 8px; justify-self: start; }
  @media (min-width: 980px) { .sv__row { grid-template-columns: 1.1fr 1.2fr 1fr; gap: 40px; } }
</style>
