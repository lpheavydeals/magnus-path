---
import Words from '../Words.astro';
import PathObject from '../PathObject.astro';
import { site } from '../../data/site';
---
<section class="hero">
  <div class="hero__bg" aria-hidden="true"></div>
  <span class="plus" style="left:8%;top:30%">+</span><span class="plus" style="right:12%;top:22%">+</span>
  <div class="wrap hero__copy">
    <p class="label" data-reveal>E-commerce growth agency · Chennai, India</p>
    <h1><Words text="E-commerce Marketing Agency for Brands That Want to *Sell* *More* *Online*" /></h1>
    <p class="lede" data-reveal>Billion Ecommerce Agency builds high-converting Shopify and WooCommerce stores, runs profitable Amazon, Flipkart, Meta and Google ads, and ranks your brand on Google and AI search — one team, measured in sales, not likes.</p>
    <div class="hero__ctas" data-reveal>
      <a class="btn btn--primary" href="/free-ecommerce-audit/">Get a free store audit <span class="arrow" aria-hidden="true">→</span></a>
      <a class="btn btn--ghost" href={site.whatsapp} rel="noopener">Chat on WhatsApp</a>
    </div>
  </div>

  <div class="hero__stage" data-expand>
    <div class="hero__panel">
      <div class="hero__grid" aria-hidden="true"></div>
      <PathObject class="hero__obj" layers={32} top="#2a2d33" side="#121316" />
      <div class="chip chip--1" aria-hidden="true"><span class="dot"></span>Shopify store · live</div>
      <div class="chip chip--2" aria-hidden="true">Amazon Ads · ROAS tracked weekly</div>
      <div class="chip chip--3" aria-hidden="true">Google · AI search visibility</div>
      <p class="hero__caption">Websites · Ads · SEO — one growth system</p>
    </div>
  </div>
</section>
<style>
  .hero { position: relative; padding: clamp(130px, 16vw, 190px) 0 clamp(40px, 6vw, 80px); overflow: hidden; }
  .hero__bg { position: absolute; inset: 0; background: radial-gradient(60% 55% at 50% 0%, #ffe7db 0%, rgba(255,231,219,0) 70%), radial-gradient(40% 40% at 90% 30%, rgba(255,176,138,.35), transparent 70%), var(--paper); }
  .hero__copy { position: relative; display: grid; justify-items: center; text-align: center; gap: 26px; }
  .hero h1 { max-width: 17ch; }
  .hero .lede { text-align: center; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .hero__stage { position: relative; margin-top: clamp(48px, 7vw, 90px); padding: 0 var(--gutter); }
  .hero__panel { position: relative; max-width: 1360px; margin: 0 auto; height: clamp(420px, 62vw, 760px); border-radius: 32px; overflow: hidden;
    background: radial-gradient(70% 90% at 70% 40%, #ff9a6e 0%, #f16436 45%, #d24a1d 100%); transform-origin: 50% 0; }
  .hero__grid { position: absolute; inset: 0; background: repeating-linear-gradient(90deg, rgba(0,0,0,.08) 0 1px, transparent 1px 80px), repeating-linear-gradient(0deg, rgba(0,0,0,.08) 0 1px, transparent 1px 80px); mask-image: radial-gradient(ellipse 60% 70% at 55% 45%, #000, transparent); }
  .hero__obj { position: absolute; width: min(68%, 820px); left: 50%; top: 50%; transform: translate(-48%, -52%); filter: drop-shadow(0 70px 60px rgba(70, 18, 0, .45)); }
  .chip { position: absolute; display: flex; align-items: center; gap: 8px; padding: 12px 16px; border-radius: 999px; background: rgba(255,255,255,.92); color: var(--ink); font-size: 14px; font-weight: 500; box-shadow: 0 20px 40px -20px rgba(0,0,0,.4); }
  .chip--1 { left: 6%; top: 14%; } .chip--2 { right: 6%; top: 40%; } .chip--3 { left: 10%; bottom: 14%; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 4px rgba(34,197,94,.25); }
  .hero__caption { position: absolute; right: 28px; bottom: 24px; color: rgba(255,255,255,.85); font-size: 14px; }
  @media (max-width: 700px) { .chip { font-size: 12px; padding: 9px 12px; } .chip--2 { top: auto; bottom: 30%; right: 4%; } .hero__obj { width: 92%; } .hero__caption { display: none; } }
</style>
