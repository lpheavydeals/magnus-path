---
import Base from '../../layouts/Base.astro';
import SimpleHero from '../../components/page/SimpleHero.astro';
import Icon3D from '../../components/Icon3D.astro';
import LeadForm from '../../components/LeadForm.astro';
import { breadcrumbSchema } from '../../data/schema';
import { freeTools } from '../../data/tools';
const groups = [...new Set(freeTools.map((t) => t.group))];
---
<Base title="Free Ecommerce Tools & Calculators | Billion Ecommerce Agency" description="Free ecommerce tools: website checker, profit margin, discount, RTO, free-shipping, ROAS, ad budget, LTV/CAC calculators and a UTM builder. No sign-up." schema={[breadcrumbSchema([{ label: 'Free Tools', href: '/tools/' }])]}>
  <SimpleHero eyebrow="Free tools" h1="Free Tools for *E-commerce Sellers*" intro="A store checker and quick calculators for margins, discounts, returns, ad budgets and customer value, built for online brands in India and abroad. They run in your browser and store nothing." current="Free Tools" />
  {groups.map((g) => (
    <section class="section tl"><div class="wrap">
      <h2 class="tl__h" data-reveal>{g}</h2>
      <ul class="tl__grid">
        {freeTools.filter((t) => t.group === g).map((t) => <li data-reveal><a href={t.href}><div class="tl__icon"><Icon3D name={t.icon} /></div><h3>{t.title}</h3><p>{t.desc}</p><span class="tl__go" aria-hidden="true">→</span></a></li>)}
      </ul>
    </div></section>
  ))}
  <section class="section tl"><div class="wrap"><p class="tl__more" data-reveal>Looking for checklists, templates and a sale calendar? See our <a href="/resources/">free ecommerce resources</a>, or get a <a href="/free-ecommerce-audit/">free store audit</a> from our team.</p></div></section>
  <LeadForm />
</Base>
<style>
  .tl { padding-top: 0; }
  .tl__h { font-size: 1.5rem; margin-bottom: 18px; }
  .tl__grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .tl__grid a { position: relative; display: grid; gap: 12px; padding: 28px; border-radius: var(--radius); background: #f3f1ee; text-decoration: none; height: 100%; transition: background .4s var(--ease), transform .4s var(--ease); }
  .tl__grid a:hover { background: var(--accent-tint); transform: translateY(-6px); }
  .tl__icon { width: 46%; margin: 0 auto 6px; }
  .tl__grid h3 { font-size: 1.3rem; }
  .tl__grid p { color: var(--muted); font-size: 15px; }
  .tl__go { position: absolute; top: 22px; right: 22px; width: 38px; height: 38px; display: grid; place-items: center; border-radius: 50%; background: var(--white); }
  .tl__more { font-size: 1.1rem; }
  @media (min-width: 700px) { .tl__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .tl__grid { grid-template-columns: repeat(3, 1fr); } }
</style>
