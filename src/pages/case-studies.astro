---
import Base from '../layouts/Base.astro';
import SimpleHero from '../components/page/SimpleHero.astro';
import CaseStack from '../components/home/CaseStack.astro';
import LeadForm from '../components/LeadForm.astro';
import { breadcrumbSchema } from '../data/schema';
---
<Base title="Case Studies | E-commerce Growth Results | Magnus Path" description="E-commerce case studies from Magnus Path: Shopify builds, Amazon and Meta ads, and e-commerce SEO for Indian D2C brands and exporters." schema={[breadcrumbSchema([{ label: 'Case Studies', href: '/case-studies/' }])]}>
  <SimpleHero eyebrow="Case studies" h1="E-commerce Growth, *Measured in Sales*" intro="How we help D2C brands and exporters grow with better stores, profitable ads and rankings that last. Each case study shows the problem, what we changed and the numbers that moved." current="Case Studies" />
  <CaseStack />
  <LeadForm heading="Want results like these?" />
</Base>
