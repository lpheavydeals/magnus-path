---
import { site } from '../data/site';
---
<div class="mbar" role="complementary" aria-label="Quick contact">
  <a class="mbar__wa" href={site.whatsapp} rel="noopener">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7a2.8 2.8 0 0 0 1.8-1.3 2.3 2.3 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3Z"/></svg>
    WhatsApp
  </a>
  <a class="mbar__audit" href="/free-ecommerce-audit/">Free Store Audit</a>
</div>
<style>
  .mbar { position: fixed; left: 12px; right: 12px; bottom: 12px; z-index: 60; display: grid; grid-template-columns: 1fr 1.4fr; gap: 8px; padding: 8px; border-radius: 999px; background: var(--ink); box-shadow: 0 12px 30px -10px rgba(0,0,0,.45); }
  .mbar a { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 48px; border-radius: 999px; font-weight: 600; font-size: 15px; text-decoration: none; }
  .mbar__wa { color: var(--white); background: #1f7a4d; }
  .mbar__audit { background: var(--accent); color: var(--ink); }
  @media (min-width: 1080px) { .mbar { display: none; } }
</style>
