---
<div class:list={['po', cls]} aria-hidden="true">
  <svg width="0" height="0" style="position:absolute"><defs>
    <symbol id={id} viewBox={VB}><path d={D} fill="currentColor" fill-rule="evenodd" /></symbol>
    <linearGradient id={id + 'g'} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".6"/><stop offset=".5" stop-color="#fff" stop-opacity="0"/></linearGradient>
  </defs></svg>
  <div class="po__stack">
    {Array.from({ length: layers }, (_, i) => (
      <svg class="po__ly" viewBox={VB} style={`transform:translateZ(${i * 1.7}px);color:${i === layers - 1 ? top : side}`}><use href={`#${id}`} /></svg>
    ))}
    <svg class="po__ly" viewBox={VB} style={`transform:translateZ(${layers * 1.7 + 0.3}px)`}><use href={`#${id}`} style={`color:transparent`} /><path d={D} fill={`url(#${id}g)`} fill-rule="evenodd" /></svg>
  </div>
</div>
<style>
  .po { perspective: 1600px; }
  .po__stack { position: relative; width: 100%; aspect-ratio: 776 / 573; transform-style: preserve-3d; transform: rotateX(52deg) rotateZ(-38deg); animation: poFloat 9s ease-in-out infinite; }
  .po__ly { position: absolute; inset: 0; width: 100%; height: 100%; }
  @keyframes poFloat { 50% { transform: rotateX(48deg) rotateZ(-30deg) translateY(-10px); } }
</style>
