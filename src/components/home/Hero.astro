---
import { site } from '../../data/site';
import mark from '../../assets/mark.svg?raw';
const bigMark = mark.replace(/width="\d+" height="\d+" /, '').replace('<svg ', '<svg aria-hidden="true" focusable="false" ');
---
<section class="hero">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">E-commerce growth agency · Chennai, India</p>
      <h1><span class="nw">E-commerce</span> Marketing Agency That Turns Clicks Into Orders</h1>
      <p class="lede">We build Shopify and WooCommerce stores, run Amazon, Flipkart, Meta and Google ads, and rank your brand on Google and AI search — one team, one dashboard, measured in sales.</p>
      <div class="hero__ctas">
        <a class="btn btn--primary" href="/free-ecommerce-audit/">Get a free store audit <span class="arrow" aria-hidden="true">↗</span></a>
        <a class="btn btn--ghost" href={site.whatsapp} rel="noopener">Chat on WhatsApp</a>
      </div>
      <ul class="hero__proof" aria-label="What you get">
        <li>Audit report within 24 hours</li>
        <li>No long lock-in contracts</li>
        <li>Weekly sales & ROAS reports</li>
      </ul>
    </div>

    <div class="hero__art" aria-hidden="true">
      <div class="art__mark" set:html={bigMark}></div>
      <span class="orb orb--lg"></span>
      <span class="orb orb--md"></span>
      <span class="orb orb--sm"></span>

      <div class="dash">
        <div class="dash__head">
          <span>Store growth · last 90 days</span>
          <span class="dash__tag">Illustrative</span>
        </div>
        <div class="dash__kpis">
          <div><small>Revenue</small><b>₹18.4L</b><em>+42%</em></div>
          <div><small>Ad ROAS</small><b>4.2×</b><em>+1.6×</em></div>
          <div><small>Organic visits</small><b>12.8k</b><em>+65%</em></div>
        </div>
        <svg class="dash__chart" viewBox="0 0 320 110" preserveAspectRatio="none">
          <defs>
            <linearGradient id="g-area" x1="0" x2="0" y1="0" y2="1">
              <stop offset="0" stop-color="#f16436" stop-opacity=".45" />
              <stop offset="1" stop-color="#f16436" stop-opacity="0" />
            </linearGradient>
          </defs>
          <g stroke="#e9e4dd" stroke-width="1"><line x1="0" x2="320" y1="27" y2="27"/><line x1="0" x2="320" y1="55" y2="55"/><line x1="0" x2="320" y1="83" y2="83"/></g>
          <path d="M0 96 C30 92 45 88 70 84 S110 70 135 72 175 58 200 50 245 40 265 30 300 16 320 10 V110 H0Z" fill="url(#g-area)" />
          <path d="M0 96 C30 92 45 88 70 84 S110 70 135 72 175 58 200 50 245 40 265 30 300 16 320 10" fill="none" stroke="#f16436" stroke-width="3" stroke-linecap="round" />
          <path d="M0 100 C40 99 80 97 120 95 S200 90 240 86 290 82 320 80" fill="none" stroke="#15171a" stroke-opacity=".25" stroke-width="2" stroke-dasharray="4 5" />
        </svg>
        <div class="dash__legend"><span><i class="k1"></i>With Magnus Path</span><span><i class="k2"></i>Before</span></div>
      </div>

      <div class="chip chip--a"><span class="dot"></span>Amazon Sponsored Products · live</div>
      <div class="chip chip--b">Page 1 on Google · “ecommerce seo”</div>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; padding: clamp(48px, 7vw, 96px) 0 clamp(64px, 8vw, 110px); }
  .hero__glow { position: absolute; inset: -20% -10% auto auto; width: 70vw; height: 70vw; max-width: 900px; max-height: 900px; background: radial-gradient(closest-side, rgba(248, 152, 91, .55), rgba(241, 100, 54, .18) 55%, transparent 75%); filter: blur(10px); pointer-events: none; }
  .hero__grid { position: relative; display: grid; gap: 56px; align-items: center; }
  .hero__copy { display: grid; gap: 24px; }
  .hero h1 { max-width: 15ch; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 4px; }
  .hero__proof { list-style: none; margin: 4px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px 22px; font-size: 15px; color: var(--muted); }
  .hero__proof li::before { content: '✓'; color: var(--accent-ink); font-weight: 700; margin-right: 8px; }

  .hero__art { position: relative; aspect-ratio: 1 / 0.92; min-height: 360px; }
  .art__mark { position: absolute; inset: 2% 0 auto 6%; width: 92%; color: var(--accent); opacity: .16; }
  .orb { position: absolute; border-radius: 50%; background: radial-gradient(circle at 32% 28%, #ffd9c2 0%, #f8985b 26%, #f16436 58%, #b8380f 100%); box-shadow: inset -18px -24px 40px rgba(120, 30, 0, .35), 0 30px 60px -20px rgba(241, 100, 54, .55); animation: float 7s ease-in-out infinite; }
  .orb--lg { width: 30%; aspect-ratio: 1; right: 2%; top: 4%; }
  .orb--md { width: 15%; aspect-ratio: 1; left: 2%; bottom: 8%; animation-delay: -2s; }
  .orb--sm { width: 8%; aspect-ratio: 1; left: 38%; bottom: 0; animation-delay: -4s; }
  @keyframes float { 50% { transform: translateY(-14px); } }

  .dash { position: absolute; left: 8%; right: 10%; top: 22%; background: rgba(255,255,255,.92); border: 1px solid rgba(255,255,255,.8); border-radius: var(--radius); box-shadow: var(--shadow); padding: 18px 18px 14px; backdrop-filter: blur(8px); }
  .dash__head { display: flex; justify-content: space-between; align-items: center; font-size: 13px; font-weight: 600; }
  .dash__tag { font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); border: 1px dashed var(--line); padding: 3px 6px; border-radius: 5px; }
  .dash__kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 14px 0; }
  .dash__kpis div { background: var(--paper); border-radius: 10px; padding: 10px; display: grid; gap: 2px; }
  .dash__kpis small { font-size: 11px; color: var(--muted); }
  .dash__kpis b { font-family: var(--font-display); font-stretch: 112%; font-size: clamp(1rem, 2vw, 1.35rem); }
  .dash__kpis em { font-style: normal; font-size: 12px; font-weight: 600; color: #15803d; }
  .dash__chart { width: 100%; height: 110px; }
  .dash__legend { display: flex; gap: 16px; font-size: 12px; color: var(--muted); margin-top: 6px; }
  .dash__legend i { display: inline-block; width: 14px; height: 3px; border-radius: 2px; margin-right: 6px; vertical-align: middle; }
  .k1 { background: var(--accent); } .k2 { background: rgba(21,23,26,.3); }
  .chip { position: absolute; background: var(--ink); color: var(--white); font-size: 13px; font-weight: 500; padding: 10px 14px; border-radius: 999px; box-shadow: var(--shadow); white-space: nowrap; }
  .chip--a { left: 0; top: 8%; display: flex; align-items: center; gap: 8px; }
  .chip--b { right: 0; bottom: 3%; background: var(--white); color: var(--ink); border: 1px solid var(--line); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 4px rgba(34,197,94,.2); }

  @media (min-width: 980px) {
    .hero__grid { grid-template-columns: 1.05fr 1fr; }
  }
  @media (max-width: 520px) {
    .chip--b { display: none; }
    .chip { font-size: 11px; padding: 8px 11px; }
    .dash { left: 0; right: 0; padding: 14px; }
    .hero__art { min-height: 330px; }
  }
</style>
