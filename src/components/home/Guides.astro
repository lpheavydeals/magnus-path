---
const guides = [
  { tag: 'Websites', title: 'E-commerce website cost in India: a 2026 guide', href: '/blog/ecommerce-website-cost-in-india/', read: '8 min read' },
  { tag: 'Platforms', title: 'Best e-commerce platform in India: Shopify vs WooCommerce vs others', href: '/blog/best-ecommerce-platform-in-india/', read: '10 min read' },
  { tag: 'Export', title: 'How to find buyers for export: a step-by-step guide for manufacturers', href: '/blog/how-to-find-buyers-for-export/', read: '12 min read' },
];
---
<section class="section gd">
  <div class="wrap">
    <div class="gd__head">
      <div class="head"><p class="label" data-reveal>Guides</p><h2 data-reveal>Learn what actually <em>grows</em> online sales</h2></div>
      <a class="btn btn--ghost" href="/blog/" data-reveal>All guides</a>
    </div>
    <ul class="gd__grid">
      {guides.map((g) => (
        <li data-reveal><a href={g.href}><div class="gd__art" aria-hidden="true"><span></span></div><span class="gd__tag">{g.tag} · {g.read}</span><h3>{g.title}</h3></a></li>
      ))}
    </ul>
  </div>
</section>
<style>
  .gd__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: clamp(36px, 5vw, 60px); }
  .gd__head .head { margin: 0; }
  .gd__grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 18px; }
  .gd__grid a { display: grid; gap: 14px; text-decoration: none; }
  .gd__art { aspect-ratio: 16 / 10; border-radius: var(--radius); background: linear-gradient(135deg, #fff1ea, #ffd9c6); position: relative; overflow: hidden; }
  .gd__art span { position: absolute; width: 46%; aspect-ratio: 1; border-radius: 50%; right: -8%; bottom: -12%; background: radial-gradient(circle at 30% 28%, #ffd2bd, #f16436 60%, #a8360e); transition: transform .8s var(--ease); }
  .gd__grid a:hover .gd__art span { transform: scale(1.15) translate(-10%, -10%); }
  .gd__tag { font-size: 13px; color: var(--muted); }
  .gd__grid h3 { font-size: 1.3rem; line-height: 1.25; transition: color .3s ease; }
  .gd__grid a:hover h3 { color: var(--accent-ink); }
  @media (min-width: 900px) { .gd__grid { grid-template-columns: repeat(3, 1fr); } }
</style>
