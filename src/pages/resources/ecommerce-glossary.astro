</Base>

<script>
  const q = document.getElementById('gl-q') as HTMLInputElement;
  const termsEl = [...document.querySelectorAll<HTMLElement>('.gl__term')];
  const groupsEl = [...document.querySelectorAll<HTMLElement>('.gl__group')];
  const total = termsEl.length;
  function filter() {
    const v = q.value.trim().toLowerCase();
    let shown = 0;
    for (const t of termsEl) { const ok = !v || (t.dataset.s || '').includes(v); t.hidden = !ok; if (ok) shown++; }
    for (const g of groupsEl) {
      const n = g.querySelectorAll('.gl__term:not([hidden])').length;
      g.hidden = n === 0;
      const a = document.querySelector<HTMLElement>(`.gl__az a[data-l="${g.dataset.l}"]`);
      if (a) a.classList.toggle('is-off', n === 0);
    }
    document.getElementById('gl-empty')!.hidden = shown > 0;
    document.getElementById('gl-count')!.textContent = v ? `${shown} of ${total} terms match "${q.value.trim()}"` : `${total} terms`;
  }
  q.addEventListener('input', filter);
  // Jumping to a letter or term clears an active search so the target is visible.
  document.querySelectorAll<HTMLAnchorElement>('.gl__az a, .gl__term dt a').forEach((a) => a.addEventListener('click', () => {
    if (q.value) { q.value = ''; filter(); }
  }));
  if (location.hash) { const el = document.getElementById(decodeURIComponent(location.hash.slice(1))); if (el && el.classList.contains('gl__term')) el.classList.add('is-target'); }
  window.addEventListener('hashchange', () => {
    document.querySelectorAll('.gl__term.is-target').forEach((e) => e.classList.remove('is-target'));
    const el = document.getElementById(decodeURIComponent(location.hash.slice(1)));
    if (el && el.classList.contains('gl__term')) el.classList.add('is-target');
  });
</script>

<style>
  .gl { padding-top: clamp(20px, 3vw, 40px); }
  .gl__wrap { display: grid; gap: 16px; max-width: 1040px; }
  .gl__bar { display: grid; gap: 12px; position: sticky; top: 76px; z-index: 5; background: var(--paper); padding: 10px 0 12px; border-bottom: 1px solid var(--line); }
  .gl__search { display: flex; align-items: center; gap: 10px; padding: 0 16px; border: 1.5px solid var(--line); border-radius: 14px; background: var(--white); color: var(--muted); }
  .gl__search:focus-within { border-color: var(--accent); }
  .gl__search input { flex: 1; min-width: 0; min-height: 50px; border: 0; background: transparent; font: 500 16px var(--font-body); color: var(--ink); }
  .gl__search input:focus { outline: none; }
  .gl__az { display: flex; gap: 4px; overflow-x: auto; scrollbar-width: thin; padding-bottom: 4px; }
  .gl__az a, .gl__az span { flex: none; }
  @media (min-width: 760px) { .gl__az { flex-wrap: wrap; overflow: visible; padding-bottom: 0; } }
  .gl__az a, .gl__az span { display: inline-grid; place-items: center; min-width: 32px; height: 32px; border-radius: 8px; font-size: 14px; font-weight: 600; }
  .gl__az a { color: var(--ink); text-decoration: none; background: var(--white); border: 1px solid var(--line); }
  .gl__az a:hover, .gl__az a:focus-visible { border-color: var(--accent); color: var(--accent-ink); }
  .gl__az a.is-off { opacity: .4; }
  .gl__az span { color: #c4c8cc; }
  .gl__count { font-size: 14px; color: var(--muted); }
  .gl__group { display: grid; gap: 4px; scroll-margin-top: 215px; }
  .gl__group[hidden], .gl__term[hidden], .gl__empty[hidden] { display: none; }
  .gl__letter { font-size: clamp(1.8rem, 3vw, 2.4rem); color: var(--accent-ink); padding-top: 14px; border-bottom: 1px solid var(--line); }
  .gl__list { margin: 0; display: grid; }
  .gl__term { display: grid; gap: 6px; padding: 18px 0; border-bottom: 1px solid var(--line); scroll-margin-top: 215px; border-radius: 12px; transition: background .4s ease; }
  .gl__term.is-target, .gl__term:target { background: var(--accent-tint); padding-left: 14px; padding-right: 14px; }
  .gl__term dt { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; }
  .gl__term dt a { font-family: var(--font-display); font-weight: 600; font-size: 1.2rem; color: var(--ink); text-decoration: none; letter-spacing: -0.01em; }
  .gl__term dt a:hover { color: var(--accent-ink); }
  .gl__full { font-size: 14px; color: var(--muted); }
  .gl__term dd { margin: 0; display: grid; gap: 8px; }
  .gl__term dd p { color: #33373d; line-height: 1.6; max-width: 75ch; }
  .gl__links { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 14px; }
  .gl__links a { color: var(--accent-ink); font-weight: 600; text-decoration: none; }
  .gl__links a:hover { text-decoration: underline; }
  .gl__empty { color: var(--muted); }
  .gl__cta { margin-top: 18px; display: flex; flex-wrap: wrap; gap: 16px; align-items: center; justify-content: space-between; padding: clamp(20px, 3vw, 30px); border-radius: 24px; background: var(--ink); color: var(--white); }
  .gl__cta p { max-width: 52ch; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  @media (min-width: 760px) {
    .gl__term { grid-template-columns: 220px 1fr; gap: 24px; }
    .gl__term dt { flex-direction: column; gap: 2px; }
  }
  @media print {
    .gl__bar, .gl__cta { display: none; }
    .gl__term { break-inside: avoid; }
  }
</style>
