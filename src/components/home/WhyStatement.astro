---
const text = 'Most brands hire one agency for the website, another for ads and a freelancer for SEO — and nobody owns the sales number. We do. One team builds your store, runs your ads and earns your rankings, so every rupee you spend is tracked to orders.';
const commitments = [
  { v: '24h', l: 'Free store audit delivered' },
  { v: '3-in-1', l: 'Websites, ads & SEO, one team' },
  { v: 'Weekly', l: 'Sales, ROAS & ranking reports' },
  { v: '0', l: 'Long lock-in contracts' },
];
---
<section class="section why">
  <span class="plus" style="left:6%;top:18%">+</span><span class="plus" style="right:9%;bottom:22%">+</span>
  <div class="wrap">
    <p class="label" data-reveal>Why Billion Ecommerce Agency</p>
    <h2 class="sr-only">Why choose Billion Ecommerce Agency as your e-commerce marketing agency</h2>
    <p class="why__text" data-lightup>{text.split(' ').map((w) => <span>{w} </span>)}</p>
    <ul class="why__stats">
      {commitments.map((c) => <li data-reveal><b>{c.v}</b><span>{c.l}</span></li>)}
    </ul>
  </div>
</section>
<style>
  .why__text { margin-top: 26px; font-family: var(--font-display); font-weight: 500; letter-spacing: -0.03em; font-size: clamp(1.7rem, 3.6vw, 3.1rem); line-height: 1.18; max-width: 26ch; color: var(--ink); }
  :global(html.js) .why__text span { color: #c9ccd0; transition: color .4s ease; }
  :global(html.js) .why__text span.on { color: var(--ink); }
  @media (prefers-reduced-motion: reduce) { :global(html.js) .why__text span { color: var(--ink); } }
  .why__stats { list-style: none; margin: clamp(48px, 7vw, 90px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
  .why__stats li { display: grid; gap: 6px; padding: 24px; border-radius: var(--radius); background: var(--white); border: 1px solid var(--line); }
  .why__stats b { font-family: var(--font-display); font-weight: 500; letter-spacing: -0.04em; font-size: clamp(2.2rem, 4vw, 3.2rem); line-height: 1; color: var(--accent); }
  .why__stats span { font-size: 15px; color: var(--muted); }
  @media (min-width: 900px) { .why__stats { grid-template-columns: repeat(4, 1fr); } }
</style>
