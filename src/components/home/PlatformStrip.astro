---
const platforms = ['Shopify', 'WooCommerce', 'Amazon', 'Flipkart', 'Myntra', 'Blinkit', 'Zepto', 'Swiggy Instamart', 'Meta Ads', 'Google Ads', 'Google Search', 'ChatGPT & AI search'];
---
<section class="strip" aria-label="Platforms we work on">
  <p class="strip__label">Platforms we grow brands on</p>
  <div class="strip__track">
    <ul>{platforms.map((p) => <li>{p}</li>)}</ul>
    <ul aria-hidden="true">{platforms.map((p) => <li>{p}</li>)}</ul>
  </div>
</section>
<style>
  .strip { padding: 34px 0 10px; display: grid; gap: 20px; }
  .strip__label { text-align: center; font-size: 14px; color: var(--muted); }
  .strip__track { display: flex; overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); }
  .strip ul { display: flex; flex: none; gap: 56px; padding-right: 56px; margin: 0; list-style: none; animation: mq 45s linear infinite; }
  .strip li { font-family: var(--font-display); font-weight: 600; font-size: 1.3rem; letter-spacing: -0.02em; color: #9a9fa6; white-space: nowrap; }
  @keyframes mq { to { transform: translateX(-100%); } }
</style>
