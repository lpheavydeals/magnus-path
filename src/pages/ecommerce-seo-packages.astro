---
import Base from '../layouts/Base.astro';
import SimpleHero from '../components/page/SimpleHero.astro';
import Tiers from '../components/page/Tiers.astro';
import Guide from '../components/page/Guide.astro';
import FAQ from '../components/FAQ.astro';
import Related from '../components/page/Related.astro';
import LeadForm from '../components/LeadForm.astro';
import { ecomSeoTiers } from '../data/pricing';
import { breadcrumbSchema, faqSchema } from '../data/schema';
const trail = [{ label: 'SEO', href: '/ecommerce-seo/' }];
const guide = [
  { heading: 'What an e-commerce SEO package should include', paragraphs: ['A good e-commerce website SEO package covers three layers. Technical SEO makes sure Google can crawl and index every product and category page without duplicates or errors. On-page SEO matches each category and product page to the searches buyers actually type. Authority building earns links and mentions that tell Google your store is trustworthy.', 'Cheap packages often skip the technical layer and sell a fixed number of backlinks instead. For online stores that is the wrong order: fixing duplicate URLs, faceted navigation and thin product pages usually moves rankings faster than any link.'], bullets: ['Technical audit: crawl errors, duplicate URLs, canonical tags, Core Web Vitals', 'Keyword mapping: one target keyword cluster per category and product type', 'Category and product page optimisation: titles, copy, FAQs, internal links', 'Structured data for products, reviews and breadcrumbs', 'Content that answers buying questions and earns links', 'Reporting on rankings, organic traffic and organic revenue'] },
  { heading: 'How we choose the right package for your store', paragraphs: ['Catalogue size and competition decide the package more than anything else. A store with 80 products in a niche category can grow on the Starter plan. A fashion or beauty store with 2,000 products competing with large marketplaces needs the volume of the Growth or Scale plan to make a visible difference within six months.', 'We recommend a plan after the free audit, based on your current rankings, the search volume available in your category and how much content your store already has.'] },
  { heading: 'How long e-commerce SEO takes to show results', paragraphs: ['Technical fixes and product-page improvements typically show ranking movement within 6–10 weeks. Competitive category keywords usually take 4–8 months to reach the first page. SEO compounds: pages that rank keep bringing orders without paying for each click, which is why stores that stay with SEO for a year usually see the best return.'] },
  { heading: 'E-commerce SEO packages vs paying for ads', paragraphs: ['Ads bring sales the day they start and stop the day you stop paying. SEO is slower to start but keeps working. Most growing brands run both: ads for immediate sales and testing, SEO for the steady, lower-cost orders that improve margins over time. Because one team at Magnus Path runs both, we use your ad data to choose which keywords to target with SEO first.'] },
  { heading: 'What is not included', paragraphs: ['Packages exclude GST, paid tools you choose to subscribe to yourself, and large site rebuilds. If your store needs development work beyond SEO fixes, such as a new theme or migration, we quote that separately through our e-commerce website development team.'] },
];
const faqs = [
  { q: 'How much do e-commerce SEO packages cost in India?', a: 'Our e-commerce SEO packages start at ₹35,000 a month for stores under 200 products, ₹60,000 a month for growing stores and ₹1,00,000 a month for large or multi-country catalogues. Prices exclude GST.' },
  { q: 'Which e-commerce SEO package is right for my store?', a: 'It depends on catalogue size and competition. Niche stores under 200 products usually start with Starter. Stores competing in fashion, beauty or electronics need Growth or Scale. We recommend a plan after the free audit.' },
  { q: 'Do your SEO packages work for Shopify and WooCommerce?', a: 'Yes. Every package works on Shopify, WooCommerce and custom stores. We handle platform-specific issues such as Shopify’s duplicate product URLs and WooCommerce’s faceted filter pages.' },
  { q: 'Is there a minimum contract?', a: 'Packages run for an initial 3 months, then continue month to month with 30 days’ notice. Three months is the minimum time needed to see whether SEO is moving in the right direction.' },
  { q: 'Do you build backlinks in your SEO packages?', a: 'Growth and Scale packages include link building through digital PR, guest content on relevant sites and supplier or partner mentions. We do not buy links from link farms or private blog networks, because they put your store at risk.' },
  { q: 'Can I upgrade or downgrade my package?', a: 'Yes. You can change plans at the start of any month. Many stores start on Starter to fix technical issues, then move to Growth once the foundation is in place.' },
];
const schema = [breadcrumbSchema([...trail, { label: 'E-commerce SEO Packages', href: '/ecommerce-seo-packages/' }]), faqSchema(faqs)];
const figures = [
  { type: 'mindmap', caption: 'The three layers every e-commerce SEO package should cover, plus reporting.', center: 'Store SEO', after: 0, branches: [
    { label: 'Technical', items: ['Crawling and indexing', 'Speed on mobile', 'Product schema'] },
    { label: 'On-page', items: ['Category pages', 'Product descriptions', 'Internal links'] },
    { label: 'Authority', items: ['Content and guides', 'Genuine links and PR'] },
    { label: 'Reporting', items: ['Rankings to revenue', 'Monthly plan'] },
  ] },
  { type: 'venn', caption: 'Ads and SEO do different jobs; the best stores use both.', after: 3, left: { title: 'Ads', body: 'sales from day one, stop when the budget stops' }, right: { title: 'SEO', body: 'slower to start, keeps bringing orders for free' }, overlap: 'Lower cost per order over time' },
];
---
<Base title="E-commerce SEO Packages & Pricing in India | Magnus Path" description="E-commerce website SEO packages from ₹35,000/month: technical SEO, category and product page optimisation, content and links for Shopify and WooCommerce stores." schema={schema}>
  <SimpleHero eyebrow="E-commerce SEO packages" h1="E-commerce Website SEO Packages *Built Around Revenue*" intro="Our e-commerce website SEO packages fix the technical problems holding your store back, optimise the category and product pages buyers search for, and build the authority that keeps you ranking. Three clear monthly plans, no long lock-ins." trail={trail} current="E-commerce SEO Packages" />
  <Tiers tiers={ecomSeoTiers} heading="Choose your e-commerce SEO package" note="All plans include a free audit to start, keyword mapping and transparent reporting. Prices exclude GST." />
  <Guide sections={guide} figures={figures as any} title="Choosing an e-commerce SEO package" />
  <FAQ items={faqs} title="E-commerce SEO package questions" />
  <Related links={[{ label: 'E-commerce SEO services', href: '/ecommerce-seo/' }, { label: 'Shopify SEO services', href: '/shopify-seo/' }, { label: 'Amazon SEO & listing optimisation', href: '/amazon-seo/' }, { label: 'SEO packages for any business', href: '/seo-packages/' }]} />
  <LeadForm heading="Find the right SEO package" />
</Base>
