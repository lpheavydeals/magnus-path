---
// TODO: replace with founder's real name, photo and words (or a real client testimonial once available).
---
<section class="fn">
  <div class="wrap fn__grid">
    <div>
      <p class="fn__label">A promise from our founder</p>
      <blockquote>
        <p>“We don’t report likes, impressions or vanity rankings. Every week you’ll see one number first — sales — and exactly what we did to move it.”</p>
        <footer><span class="fn__avatar" aria-hidden="true">MP</span><span><strong>[Founder name]</strong><br />Founder, Magnus Path</span></footer>
      </blockquote>
    </div>
    <svg class="fn__art" viewBox="0 0 200 200" aria-hidden="true">
      <g fill="none" stroke="currentColor" stroke-width="1.2">
        {Array.from({ length: 9 }, (_, i) => <path d={`M${20 + i * 20} 10 Q ${100} ${100} ${20 + i * 20} 190`} />)}
        {Array.from({ length: 9 }, (_, i) => <path d={`M10 ${20 + i * 20} Q ${100} ${100} 190 ${20 + i * 20}`} />)}
      </g>
    </svg>
  </div>
</section>
<style>
  .fn { background: var(--accent); color: var(--ink); padding: clamp(64px, 9vw, 112px) 0; overflow: hidden; }
  .fn__grid { display: grid; gap: 40px; align-items: center; }
  .fn__label { font-size: 13px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; margin-bottom: 22px; }
  blockquote { margin: 0; display: grid; gap: 28px; }
  blockquote p { font-family: var(--font-display); font-stretch: 112%; font-weight: 700; font-size: clamp(1.6rem, 3.4vw, 2.7rem); line-height: 1.15; letter-spacing: -0.015em; max-width: 26ch; }
  blockquote footer { display: flex; gap: 14px; align-items: center; font-size: 15px; }
  .fn__avatar { width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; background: var(--ink); color: var(--accent); font-weight: 700; }
  .fn__art { width: min(320px, 70%); justify-self: center; color: rgba(21,23,26,.55); }
  @media (min-width: 900px) { .fn__grid { grid-template-columns: 1.5fr 1fr; } }
</style>
