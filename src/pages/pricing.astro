---
import Base from '../layouts/Base.astro';
import SimpleHero from '../components/page/SimpleHero.astro';
import Tiers from '../components/page/Tiers.astro';
import FAQ from '../components/FAQ.astro';
import LeadForm from '../components/LeadForm.astro';
import { priceList, websiteTiers, businessTiers } from '../data/pricing';
import { breadcrumbSchema, faqSchema } from '../data/schema';
const faqs = [
  { q: 'Do your prices include GST and ad spend?', a: 'No. All prices exclude 18% GST. For ads services, the monthly fee covers our management work; your ad budget is paid directly to Amazon, Flipkart, Meta, Google or the quick-commerce platform from your own account.' },
  { q: 'Is there a minimum contract period?', a: 'Website projects are one-time. Ads and SEO retainers have a 3-month initial period, because that is the minimum time needed to judge results fairly, and then continue month to month with 30 days’ notice.' },
  { q: 'Can I combine services into one package?', a: 'Yes. Most brands combine a website with ads or SEO. When you take two or more monthly services together, we quote a combined retainer that costs less than buying each separately.' },
  { q: 'Why do prices start from a range instead of a fixed number?', a: 'Every store is different: catalogue size, number of channels, ad spend and competition change the work involved. Starting prices show the entry point; you get a fixed written quote after the free audit.' },
  { q: 'How do payments work?', a: 'Website projects are billed 50% to start and 50% at launch. Monthly retainers are billed in advance at the start of each month. We accept bank transfer and UPI, and international clients can pay in USD.' },
  { q: 'Do you offer a free consultation?', a: 'Yes. The free store audit includes a recorded walkthrough of your store, ads and SEO, followed by a call to discuss the plan and an exact quote. There is no obligation to hire us.' },
];
const schema = [breadcrumbSchema([{ label: 'Pricing', href: '/pricing/' }]), faqSchema(faqs)];
---
<Base title="Pricing: E-commerce Websites, Ads & SEO | Magnus Path" description="Transparent starting prices for Shopify and WooCommerce stores, Amazon, Flipkart, Meta and Google ads, and e-commerce SEO from Magnus Path, Chennai." schema={schema}>
  <SimpleHero eyebrow="Pricing" h1="Clear Pricing for E-commerce *Websites, Ads and SEO*" intro="Starting prices for every service we offer. Your exact quote comes after a free audit, so you only pay for the work your store actually needs. All prices exclude GST; ads prices exclude ad spend." current="Pricing" />
  <section class="section pl">
    <div class="wrap pl__grid">
      {priceList.map((g) => (
        <div class="pl__group" data-reveal>
          <h2>{g.group}</h2>
          <ul>
            {g.rows.map((r) => (
              <li><a href={r.href}><span class="pl__name">{r.name}</span><span class="pl__price"><b>{r.price}</b> <small>{r.unit}</small></span></a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
  <Tiers tiers={websiteTiers} heading="Shopify website packages" label="Website packages" note="Fixed-price packages for new and growing brands. Every package is mobile-first, SEO-ready and built for Indian payments." />
  <Tiers tiers={businessTiers} heading="Affordable business website packages" label="Business websites" note="Professional websites for companies, manufacturers and service businesses. Prices exclude GST and domain/hosting." />
  <section class="section pl-links">
    <div class="wrap pl-links__grid">
      <a href="/ecommerce-seo-packages/" data-reveal><span class="label">SEO</span><h3>E-commerce SEO packages</h3><p>Monthly SEO plans for online stores, from ₹35,000 a month.</p><span class="go" aria-hidden="true">→</span></a>
      <a href="/seo-packages/" data-reveal><span class="label">SEO</span><h3>SEO packages for any business</h3><p>Local and national SEO plans, from ₹25,000 a month.</p><span class="go" aria-hidden="true">→</span></a>
    </div>
  </section>
  <FAQ items={faqs} title="Pricing questions" />
  <LeadForm heading="Get an exact quote" sub="Tell us about your store. Within 24 hours you get a free audit and a written quote for the services that will move your sales fastest." />
</Base>
<style>
  .pl { padding-top: 0; }
  .pl__grid { display: grid; gap: 20px; }
  .pl__group { padding: clamp(22px, 3vw, 34px); border-radius: 28px; background: var(--white); border: 1px solid var(--line); }
  .pl__group h2 { font-size: 1.6rem; margin-bottom: 12px; }
  .pl__group ul { list-style: none; margin: 0; padding: 0; }
  .pl__group a { display: flex; justify-content: space-between; gap: 16px; align-items: baseline; padding: 16px 0; border-bottom: 1px solid var(--line); text-decoration: none; transition: color .2s ease; }
  .pl__group li:last-child a { border-bottom: 0; }
  .pl__group a:hover { color: var(--accent-ink); }
  .pl__name { font-weight: 500; min-width: 0; }
  .pl__price { text-align: right; white-space: nowrap; }
  .pl__price b { font-family: var(--font-display); font-weight: 600; font-size: 1.15rem; }
  .pl__price small { display: block; color: var(--muted); font-size: 12.5px; white-space: normal; }
  .pl-links { padding-top: 0; }
  .pl-links__grid { display: grid; gap: 16px; }
  .pl-links__grid a { position: relative; display: grid; gap: 10px; padding: 30px; border-radius: 28px; background: linear-gradient(130deg, #fff, #fff1ea 60%, #ffd9c6); text-decoration: none; transition: transform .4s var(--ease); }
  .pl-links__grid a:hover { transform: translateY(-4px); }
  .pl-links__grid p { color: var(--muted); }
  .go { position: absolute; top: 26px; right: 26px; width: 40px; height: 40px; display: grid; place-items: center; border-radius: 50%; background: var(--ink); color: var(--white); }
  @media (min-width: 900px) { .pl__grid, .pl-links__grid { grid-template-columns: 1fr 1fr; } }
</style>
