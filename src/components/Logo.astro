---
import mark from '../assets/mark.svg?raw';
import { site } from '../data/site';
interface Props { variant?: 'lockup' | 'mark'; class?: string; }
const { variant = 'lockup', class: cls = '' } = Astro.props;
const clean = (svg: string) => svg.replace(/width="\d+" height="\d+" /, '').replace('<svg ', '<svg aria-hidden="true" focusable="false" ');
---
<span class:list={['logo', `logo--${variant}`, cls]}>
  <span class="logo__mark" set:html={clean(mark)} />
  {variant === 'lockup' && <span class="logo__word">{site.name}</span>}
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; color: var(--accent); }
  .logo__mark { width: 46px; flex: none; }
  .logo__word { flex: none; font: 700 clamp(15px, 4.6vw, 20px)/1 var(--font-body); letter-spacing: -0.02em; white-space: nowrap; }
  .logo :global(svg) { width: 100%; height: auto; }
</style>
