---
// Commitments (not results). TODO: client to confirm each before launch.
const stats = [
  { value: '24 hrs', label: 'to deliver your free store audit' },
  { value: '3 in 1', label: 'websites, ads and SEO under one team' },
  { value: 'Weekly', label: 'sales, ROAS and ranking reports' },
  { value: '7+', label: 'channels: Shopify, Amazon, Flipkart, Blinkit, Meta, Google, AI search' },
];
---
<section class="section dark ss">
  <div class="ss__mesh" aria-hidden="true"></div>
  <div class="wrap">
    <p class="eyebrow">Why Magnus Path</p>
    <p class="ss__statement">
      Most brands hire one agency for the website, another for ads and a freelancer for SEO —
      <span>and nobody owns the sales number.</span> We do. One team builds the store, runs the ads and earns the rankings,
      <span>so every rupee you spend is tracked to orders.</span>
    </p>
    <ul class="ss__stats">
      {stats.map((s) => <li><b>{s.value}</b><span>{s.label}</span></li>)}
    </ul>
  </div>
</section>
<style>
  .ss { position: relative; overflow: hidden; }
  .ss__mesh { position: absolute; inset: 0; opacity: .5; background:
      radial-gradient(600px 300px at 85% 110%, rgba(241,100,54,.35), transparent 70%),
      repeating-linear-gradient(45deg, rgba(255,255,255,.035) 0 1px, transparent 1px 46px),
      repeating-linear-gradient(-45deg, rgba(255,255,255,.035) 0 1px, transparent 1px 46px); }
  .ss .wrap { position: relative; }
  .ss__statement { margin-top: 28px; font-size: clamp(1.5rem, 3.2vw, 2.6rem); line-height: 1.25; font-weight: 400; letter-spacing: -0.015em; max-width: 30ch; color: var(--muted-on-dark); }
  .ss__statement span { color: var(--white); }
  .ss__stats { list-style: none; margin: clamp(48px, 7vw, 80px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
  .ss__stats li { display: grid; gap: 8px; align-content: start; padding: 22px; border-radius: var(--radius); background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1); backdrop-filter: blur(8px); }
  .ss__stats b { font-family: var(--font-display); font-stretch: 118%; font-size: clamp(1.8rem, 3.4vw, 2.6rem); color: var(--accent); line-height: 1; }
  .ss__stats span { font-size: 15px; color: var(--muted-on-dark); }
  @media (min-width: 900px) { .ss__stats { grid-template-columns: repeat(4, 1fr); } }
</style>
