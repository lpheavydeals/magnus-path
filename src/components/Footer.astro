---
import Logo from './Logo.astro';
import { site } from '../data/site';
const cols = [
  { title: 'Websites', links: [
    ['E-commerce Website Development', '/ecommerce-website-development/'],
    ['Shopify Development', '/shopify-development/'],
    ['WooCommerce Development', '/woocommerce-development/'],
  ]},
  { title: 'Ads', links: [
    ['Performance Marketing', '/performance-marketing/'],
    ['Amazon Advertising Agency', '/amazon-marketing-agency/'],
    ['Amazon Account Management', '/amazon-account-management/'],
    ['Flipkart Account Management', '/flipkart-account-management/'],
  ]},
  { title: 'SEO', links: [
    ['E-commerce SEO Services', '/ecommerce-seo/'],
    ['E-commerce SEO Packages', '/ecommerce-seo-packages/'],
    ['Shopify SEO', '/shopify-seo/'],
    ['Amazon SEO', '/amazon-seo/'],
  ]},
  { title: 'Chennai & beyond', links: [
    ['Digital Marketing Agency in Chennai', '/chennai/digital-marketing-agency/'],
    ['SEO Company in Chennai', '/chennai/seo-company/'],
    ['E-commerce Website Development Chennai', '/chennai/ecommerce-website-development/'],
    ['B2B Marketing for Manufacturers & Exporters', '/b2b-digital-marketing/'],
  ]},
  { title: 'Company', links: [
    ['About', '/about/'], ['Case Studies', '/case-studies/'], ['Pricing', '/pricing/'],
    ['Blog', '/blog/'], ['Careers', '/careers/'], ['Contact', '/contact/'],
  ]},
];
const year = new Date().getFullYear();
---
<footer class="ftr dark">
  <div class="wrap">
    <div class="ftr__top">
      <div class="ftr__brand">
        <Logo />
        <p>{site.tagline}</p>
        <address>
          <strong>{site.name}</strong><br />
          {site.address.street}, {site.address.locality}, {site.address.region} {site.address.postalCode}, India<br />
          <a href={site.phoneHref}>{site.phone}</a> · <a href={`mailto:${site.email}`}>{site.email}</a><br />
          {site.hours}
        </address>
      </div>
      <div class="ftr__cols">
        {cols.map((c) => (
          <nav aria-label={c.title}>
            <h2 class="ftr__h">{c.title}</h2>
            <ul>{c.links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul>
          </nav>
        ))}
      </div>
    </div>
    <div class="ftr__bottom">
      <span>© {year} {site.legalName}. All rights reserved.</span>
      <span class="ftr__legal"><a href="/privacy-policy/">Privacy</a><a href="/terms/">Terms</a><a href={site.social.linkedin}>LinkedIn</a><a href={site.social.instagram}>Instagram</a><a href={site.social.youtube}>YouTube</a></span>
    </div>
  </div>
</footer>
<style>
  .ftr { padding: 72px 0 110px; }
  .ftr__top { display: grid; gap: 48px; }
  .ftr__brand { display: grid; gap: 18px; max-width: 360px; align-content: start; }
  .ftr__brand p { color: var(--muted-on-dark); }
  address { font-style: normal; color: var(--muted-on-dark); font-size: 15px; line-height: 1.7; }
  address strong { color: var(--white); }
  .ftr a { text-decoration: none; color: var(--muted-on-dark); }
  .ftr a:hover { color: var(--accent); }
  .ftr__cols { display: grid; grid-template-columns: repeat(2, 1fr); gap: 32px 24px; }
  .ftr__h { font-family: var(--font-body); font-size: 13px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--white); margin-bottom: 14px; }
  .ftr ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; font-size: 15px; }
  .ftr__bottom { margin-top: 56px; padding-top: 24px; border-top: 1px solid var(--line-dark); display: flex; flex-wrap: wrap; gap: 16px; justify-content: space-between; font-size: 14px; color: var(--muted-on-dark); }
  .ftr__legal { display: flex; flex-wrap: wrap; gap: 18px; }
  @media (min-width: 760px) { .ftr__cols { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1080px) { .ftr__top { grid-template-columns: 320px 1fr; } .ftr__cols { grid-template-columns: repeat(5, 1fr); } .ftr { padding-bottom: 72px; } }
</style>
