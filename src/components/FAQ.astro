---
interface Props { items: { q: string; a: string }[]; title?: string; }
const { items, title = 'Answers to popular questions' } = Astro.props;
---
<section class="section faq">
  <div class="wrap faq__grid">
    <div class="faq__left"><p class="label" data-reveal>FAQ</p><h2 data-reveal>{title}</h2></div>
    <div class="faq__list">
      {items.map((f, i) => (
        <details open={i === 0} data-reveal>
          <summary><h3>{f.q}</h3><span aria-hidden="true"><svg viewBox="0 0 12 12" width="12"><path d="M3 9L9 3M4 3h5v5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></span></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  .faq__grid { display: grid; gap: 40px; }
  .faq__left { display: grid; gap: 18px; align-content: start; }
  details { border-bottom: 1px solid var(--line); }
  summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; gap: 24px; align-items: center; padding: 24px 0; }
  summary::-webkit-details-marker { display: none; }
  summary h3 { font-family: var(--font-body); font-weight: 500; font-size: 1.12rem; letter-spacing: -0.01em; line-height: 1.4; }
  summary span { flex: none; width: 38px; height: 38px; display: grid; place-items: center; border-radius: 50%; background: var(--ink); color: var(--white); transition: transform .4s var(--ease), background .3s ease; }
  details[open] summary span { transform: rotate(90deg); background: var(--accent); }
  details p { padding: 0 60px 26px 0; color: var(--muted); }
  @media (min-width: 980px) { .faq__grid { grid-template-columns: 1fr 1.5fr; gap: 80px; } .faq__left { position: sticky; top: 140px; align-self: start; } }
</style>
