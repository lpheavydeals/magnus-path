---
import { site } from '../data/site';
interface Props { heading?: string; sub?: string; market?: 'US' | 'UK' | 'UAE' | 'AU'; }
const salesRanges = {
  IN: ['Under ₹5 lakh', '₹5–25 lakh', '₹25 lakh – 1 crore', 'Above ₹1 crore'],
  US: ['Under $10k', '$10k–50k', '$50k–250k', 'Above $250k'],
  UK: ['Under £10k', '£10k–50k', '£50k–250k', 'Above £250k'],
  AU: ['Under A$15k', 'A$15k–75k', 'A$75k–350k', 'Above A$350k'],
  UAE: ['Under AED 50k', 'AED 50k–200k', 'AED 200k–1M', 'Above AED 1M'],
};
const { market, heading = 'Ready to sell more online?', sub = 'Get a free e-commerce store audit. Within 24 hours you receive a video walkthrough and a PDF with the fixes that will move your sales fastest.' } = Astro.props;
---
<section class="cta" id="audit">
  <div class="cta__waves" aria-hidden="true">
    <svg viewBox="0 0 1440 600" preserveAspectRatio="none">
      <path class="wv wv1" d="M0 300 C 240 200 480 420 720 320 S 1200 180 1440 300 V600 H0Z" />
      <path class="wv wv2" d="M0 360 C 300 260 520 480 760 380 S 1180 260 1440 360 V600 H0Z" />
      <path class="wv wv3" d="M0 430 C 260 360 560 520 820 440 S 1220 360 1440 430 V600 H0Z" />
    </svg>
  </div>
  <div class="wrap cta__grid">
    <div class="cta__copy">
      <p class="label" data-reveal>Free audit · no obligation</p>
      <h2 data-reveal>{heading}</h2>
      <p class="lede" data-reveal>{sub}</p>
      <ul data-reveal>
        <li>Speed and conversion leaks on your store</li>
        <li>Wasted spend in Amazon, Meta and Google ads</li>
        <li>SEO and AI-search gaps against your top 3 competitors</li>
      </ul>
      <p class="cta__alt" data-reveal>Prefer to talk? <a href={site.whatsapp} rel="noopener">WhatsApp us</a> or call <a href={site.phoneHref}>{site.phone}</a></p>
    </div>
    <form class="cta__form" action={site.formEndpoint} method="post" data-reveal>
      <input type="hidden" name="source" value="website-audit-form" />
      <label>Your name<input name="name" autocomplete="name" required /></label>
      <label>Work email<input name="email" type="email" autocomplete="email" required /></label>
      <label>{market ? "Phone or WhatsApp" : "WhatsApp number"}<input name="phone" type="tel" autocomplete="tel" inputmode="tel" required /></label>
      <label>Monthly online sales
        <select name="sales" required>
          <option value="">Select a range</option>
          <option>Just starting</option>{salesRanges[market ?? 'IN'].map((r) => <option>{r}</option>)}
        </select>
      </label>
      <label class="full">Store, Amazon or website link<input name="store" type="url" placeholder="https://" required /></label>
      <label class="full">What do you need most?
        <select name="service">
          <option>Not sure — audit everything</option><option>New or better website</option><option>Amazon / Flipkart ads</option><option>Meta / Google ads</option><option>SEO & AI search</option><option>B2B / export leads</option>
        </select>
      </label>
      <button class="btn btn--primary full" type="submit">Send my free audit request <span class="arrow" aria-hidden="true">→</span></button>
      <p class="cta__note full">We reply within one working day. No spam, ever.</p>
    </form>
  </div>
</section>
<style>
  .cta { position: relative; overflow: hidden; padding: var(--section) 0 clamp(80px, 10vw, 140px); background: linear-gradient(180deg, var(--paper) 0%, #fff4ee 40%, #ffe2d3 100%); }
  .cta__waves { position: absolute; inset: auto 0 0 0; height: 75%; }
  .cta__waves svg { width: 140%; max-width: none; height: 100%; margin-left: -20%; }
  .wv { transform-origin: center; animation: wave 14s ease-in-out infinite alternate; }
  .wv1 { fill: rgba(255, 176, 138, .35); } .wv2 { fill: rgba(241, 100, 54, .22); animation-duration: 18s; animation-direction: alternate-reverse; } .wv3 { fill: rgba(241, 100, 54, .28); animation-duration: 11s; }
  @keyframes wave { 0% { transform: translateX(-6%) scaleY(1); } 100% { transform: translateX(6%) scaleY(1.15); } }
  .cta__grid { position: relative; display: grid; gap: 48px; align-items: start; }
  .cta__copy { display: grid; gap: 20px; }
  .cta__copy ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .cta__copy li::before { content: '+'; color: var(--accent); font-weight: 600; margin-right: 12px; }
  .cta__alt { color: var(--muted); }
  .cta__form { display: grid; gap: 14px; padding: clamp(22px, 3vw, 34px); border-radius: 28px; background: rgba(255,255,255,.85); backdrop-filter: blur(16px); border: 1px solid rgba(255,255,255,.9); box-shadow: var(--shadow); }
  .cta__form label { display: grid; gap: 6px; font-size: 14px; font-weight: 500; }
  .cta__form input, .cta__form select { width: 100%; min-height: 50px; padding: 0 16px; font: 400 16px var(--font-body); color: var(--ink); background: var(--white); border: 1.5px solid var(--line); border-radius: 14px; transition: border-color .2s ease; }
  .cta__form input:focus, .cta__form select:focus { outline: none; border-color: var(--accent); }
  .cta__form .btn { margin-top: 6px; }
  .cta__note { font-size: 13px; color: var(--muted); text-align: center; }
  @media (min-width: 680px) { .cta__form { grid-template-columns: 1fr 1fr; } .cta__form .full { grid-column: 1 / -1; } }
  @media (min-width: 980px) { .cta__grid { grid-template-columns: 1fr 1.05fr; gap: 80px; } }
</style>
