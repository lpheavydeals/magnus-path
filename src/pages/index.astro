---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import PlatformStrip from '../components/home/PlatformStrip.astro';
import Services from '../components/home/Services.astro';
import Industries from '../components/home/Industries.astro';
import WhyStatement from '../components/home/WhyStatement.astro';
import Process from '../components/home/Process.astro';
import CaseStack from '../components/home/CaseStack.astro';
import Locations from '../components/home/Locations.astro';
import Qualify from '../components/home/Qualify.astro';
import Guides from '../components/home/Guides.astro';
import FAQ from '../components/FAQ.astro';
import LeadForm from '../components/LeadForm.astro';
import FigureBand from '../components/figures/FigureBand.astro';
import type { Figure } from '../data/types';
const homeMap: Figure = { type: 'mindmap', caption: 'One team for your store, your ads and your search rankings, in India and abroad.', center: 'Billion Ecommerce Agency', branches: [
  { label: 'Websites', items: ['Shopify and WooCommerce', 'Corporate websites', 'Care and maintenance'] },
  { label: 'Ads', items: ['Meta and Google', 'Amazon and Flipkart', 'Quick commerce, ChatGPT'] },
  { label: 'SEO', items: ['Store and marketplace SEO', 'AI search visibility'] },
  { label: 'Where', items: ['Chennai, Bengaluru, London', 'India, UK, US, UAE, Australia'] },
] };
const homeVenn: Figure = { type: 'venn', caption: 'The sweet spot: our team’s speed and specialists, plus what only you know about your customers.', left: { title: 'What we do best', body: 'speed, specialists, testing and reporting every week' }, right: { title: 'What only you know', body: 'your product, customers, margins and brand story' }, overlap: 'A brand that outsells bigger rivals' };
import { site } from '../data/site';

const faqs = [
  { q: 'What does an e-commerce marketing agency do?', a: 'An e-commerce marketing agency grows your online sales. At Billion Ecommerce Agency one team handles three things: building or improving your store (Shopify, WooCommerce or custom), running ads on Amazon, Flipkart, Meta, Google and quick-commerce apps, and ranking your brand on Google, marketplaces and AI search through SEO.' },
  { q: 'How much does an e-commerce marketing agency cost in India?', a: 'Store builds are one-time projects; ads and SEO run on monthly retainers. The cost depends on the number of pages and products, integrations, channels, content and how competitive your category is. We quote after a free audit, listing scope, timeline and exclusions. Ad spend is paid directly to the platforms from your account, and our fee is quoted separately.' },
  { q: 'Do you only work with brands in Chennai?', a: 'No. Our head office is in Chennai, and clients can also meet us at our offices in Bengaluru and London. We work with brands across India and with businesses in the UK, UAE, Australia, Singapore and the USA through weekly video calls.' },
  { q: 'Can you manage both our Shopify store and our Amazon account?', a: 'Yes — that is our core strength. One team runs your website, marketplace accounts and ads, so pricing, stock, promotions and reporting stay consistent across every channel.' },
  { q: 'How long does e-commerce SEO take to show results?', a: 'Technical fixes and product-page improvements usually show movement in 6–10 weeks. Rankings for competitive category keywords typically take 4–8 months. We report rankings, organic traffic and organic revenue every week.' },
  { q: 'Do you run ads on Blinkit, Zepto and Instamart?', a: 'Yes. We set up and manage quick-commerce listings and ads for food, FMCG, beauty and wellness brands, alongside Amazon and Flipkart, so you can plan budgets across every marketplace together.' },
  { q: 'Do you work with manufacturers and exporters?', a: 'Yes. For B2B manufacturers and exporters we build lead-generating websites, run export SEO and LinkedIn and Google ads that bring enquiries from international buyers — an alternative to relying only on IndiaMART and trade fairs.' },
  { q: 'Is there a long-term contract?', a: 'No long lock-ins. Retainers run month to month after an initial 3-month period, which is the minimum time needed to judge ads and SEO fairly.' },
];

const services = ['Shopify development', 'E-commerce website development', 'Amazon advertising', 'Amazon account management', 'Flipkart account management', 'Meta and Google ads', 'Quick commerce ads', 'E-commerce SEO', 'AI search optimisation', 'B2B digital marketing'];
const schema = [
  { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${site.url}/#website`, url: site.url, name: site.name, publisher: { '@id': `${site.url}/#org` } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'OfferCatalog', name: 'E-commerce marketing services', provider: { '@id': `${site.url}/#org` }, itemListElement: services.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s, areaServed: 'IN' } })) },
];
---
<Base
  title="E-commerce Marketing Agency in India | Billion Ecommerce Agency"
  description="Billion Ecommerce Agency is a Chennai-based e-commerce marketing agency. We build Shopify & WooCommerce stores, run Amazon, Flipkart, Meta & Google ads, and rank brands on Google and AI search. Get a free store audit."
  schema={schema}
>
  <Hero />
  <PlatformStrip />
  <FigureBand figure={homeMap} n={1} label="What we do, at a glance" />
  <Services />
  <Industries />
  <WhyStatement />
  <FigureBand figure={homeVenn} n={2} label="Why it works" />
  <Process />
  <CaseStack />
  <Locations />
  <Qualify />
  <Guides />
  <FAQ items={faqs} />
  <LeadForm />
</Base>
