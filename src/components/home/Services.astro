---
import Icon3D from '../Icon3D.astro';
type I = 'shopify' | 'website' | 'amazon' | 'marketplace' | 'social' | 'quick' | 'seo' | 'ai';
const services: { icon: I; title: string; href: string; tags: string[]; line: string }[] = [
  { icon: 'shopify', title: 'Shopify Development', href: '/shopify-development/', tags: ['Store design', 'Shopify Plus', 'Apps & integrations'], line: 'Conversion-first Shopify stores built to sell' },
  { icon: 'website', title: 'E-commerce Website Development', href: '/ecommerce-website-development/', tags: ['WooCommerce', 'Custom builds', 'UPI · COD · GST'], line: 'Fast stores on the platform that fits your business' },
  { icon: 'website', title: 'Corporate & Business Websites', href: '/corporate-website-development/', tags: ['Corporate sites', 'WordPress', 'Maintenance'], line: 'Professional websites that bring enquiries' },
  { icon: 'amazon', title: 'Amazon Advertising', href: '/amazon-marketing-agency/', tags: ['Sponsored Products', 'Sponsored Brands', 'DSP'], line: 'Lower ACoS, more profitable orders' },
  { icon: 'marketplace', title: 'Amazon & Flipkart Account Management', href: '/amazon-account-management/', tags: ['Listings', 'Catalogue', 'Flipkart ads'], line: 'Marketplace growth handled end to end' },
  { icon: 'social', title: 'Meta & Google Ads', href: '/performance-marketing/', tags: ['Meta', 'Google Shopping', 'Performance Max'], line: 'Performance marketing tracked to revenue' },
  { icon: 'quick', title: 'Quick Commerce Ads', href: '/quick-commerce-marketing/', tags: ['Blinkit', 'Zepto', 'Instamart'], line: 'Win the 10-minute shelf in your cities' },
  { icon: 'seo', title: 'E-commerce SEO', href: '/ecommerce-seo/', tags: ['Technical SEO', 'Category pages', 'Amazon SEO'], line: 'Rankings that bring orders without ad spend' },
  { icon: 'ai', title: 'AI Search Optimisation', href: '/ai-search-optimization/', tags: ['ChatGPT', 'Google AI Overviews', 'GEO'], line: 'Get recommended when buyers ask AI' },
];
---
<section class="section sv" id="services" data-hscroll>
  <div class="wrap sv__head">
    <div class="head">
      <p class="label" data-reveal>What we do</p>
      <h2 data-reveal>E-commerce websites, ads and SEO — <em>under one roof</em></h2>
    </div>
    <p class="lede" data-reveal>Every service your online store needs to grow, run by one team that shares one goal: more profitable orders.</p>
  </div>
  <div class="sv__viewport">
    <ul class="sv__track" data-hscroll-track>
      {services.map((s) => (
        <li class="sv__card">
          <a href={s.href}>
            <div class="sv__icon"><Icon3D name={s.icon} /></div>
            <h3>{s.title}</h3>
            <ul class="sv__tags">{s.tags.map((t) => <li>{t}</li>)}</ul>
            <p>{s.line}</p>
            <span class="sv__go" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .sv { overflow: hidden; }
  .sv__head { display: grid; gap: 10px; align-items: end; margin-bottom: clamp(36px, 5vw, 60px); }
  .sv__head .head { margin: 0; }
  .sv__viewport { overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding: 0 var(--gutter) 10px; }
  .sv__viewport::-webkit-scrollbar { display: none; }
  .sv__track { display: flex; gap: 16px; list-style: none; margin: 0; padding: 0; width: max-content; }
  .sv__card { width: min(78vw, 330px); scroll-snap-align: start; }
  .sv__card > a { position: relative; display: grid; gap: 14px; align-content: start; height: 100%; padding: 26px; border-radius: var(--radius); background: #f3f1ee; text-decoration: none; transition: background .4s var(--ease), transform .4s var(--ease); }
  .sv__card > a:hover { background: var(--accent-tint); transform: translateY(-6px); }
  .sv__icon { width: 75%; margin: 4px auto 10px; transition: transform .6s var(--ease); }
  .sv__card > a:hover .sv__icon { transform: translateY(-6px) rotate(-3deg) scale(1.04); }
  .sv__card h3 { font-size: 1.45rem; }
  .sv__tags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .sv__tags li { font-size: 12.5px; padding: 5px 10px; border-radius: 999px; background: var(--white); color: var(--muted); }
  .sv__card p { font-size: 14px; color: var(--muted); padding-top: 12px; border-top: 1px solid rgba(0,0,0,.06); }
  .sv__go { position: absolute; top: 22px; right: 22px; width: 38px; height: 38px; display: grid; place-items: center; border-radius: 50%; background: var(--white); transition: background .3s ease, color .3s ease, transform .4s var(--ease); }
  .sv__card > a:hover .sv__go { background: var(--accent); color: var(--white); transform: rotate(-45deg); }
  @media (min-width: 900px) {
    .sv__head { grid-template-columns: 1.2fr 1fr; gap: 48px; }
    .sv__viewport { overflow: visible; padding-left: max(var(--gutter), calc((100vw - var(--wrap)) / 2 + var(--gutter))); }
    .sv__card { width: 360px; }
  }
</style>
