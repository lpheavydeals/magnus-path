---
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  schema?: object[];
  ogImage?: string;
  lang?: string;
  noindex?: boolean;
  alternates?: { hreflang: string; href: string }[];
}
const { title, description, schema = [], ogImage = '/og-default.png', lang = 'en-IN', noindex = false, alternates = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'ProfessionalService'],
  '@id': `${site.url}/#org`,
  name: site.name,
  url: site.url,
  logo: `${site.url}/logo-mark.svg`,
  email: site.email,
  telephone: site.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.locality,
    addressRegion: site.address.region,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country,
  },
  location: site.offices.map((o) => ({
    '@type': 'Place',
    name: `${site.name} ${o.locality}`,
    address: { '@type': 'PostalAddress', streetAddress: o.street, addressLocality: o.locality, addressRegion: o.region, postalCode: o.postalCode, addressCountry: o.country },
    telephone: o.phone,
  })),
  areaServed: ['IN', 'GB', 'AU', 'AE', 'US'],
  knowsAbout: ['E-commerce website development', 'Shopify development', 'Amazon advertising', 'Flipkart ads', 'E-commerce SEO', 'Performance marketing'],
  sameAs: Object.values(site.social).filter((u) => u !== '#'),
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={new URL(a.href, Astro.site ?? site.url).href} />)}
    <meta name="theme-color" content="#fbfaf8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site ?? site.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify([orgSchema, ...schema])} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <MobileBar />
    <script>import '../scripts/motion.ts';</script>
  </body>
</html>
