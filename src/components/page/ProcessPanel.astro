---
interface Props { steps: { title: string; body: string }[]; heading: string; label?: string; ctaLabel?: string; }
const { steps, heading, label = 'How it works', ctaLabel = 'Start with a free audit' } = Astro.props;
---
<section class="pp" data-float-scope>
  <div class="pp__panel dark">
    <div class="pp__objs" aria-hidden="true">
      <span class="ob ob--1" data-float="-60"></span><span class="ob ob--2" data-float="80"></span><span class="ob ob--3" data-float="-120"></span>
      <span class="cube cube--1" data-float="100"></span><span class="cube cube--2" data-float="-70"></span>
    </div>
    <div class="pp__grid">
      <div class="pp__left">
        <p class="label">{label}</p>
        <h2 set:html={heading.replace(/\*(.+?)\*/g, '<em>$1</em>')} />
        <a class="btn btn--primary" href="/free-ecommerce-audit/">{ctaLabel} <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <ol class="pp__steps">
        {steps.map((s, i) => (
          <li data-reveal><span class="pp__n">Step {i + 1}</span><h3>{s.title}</h3><p>{s.body}</p></li>
        ))}
      </ol>
    </div>
  </div>
</section>
<style>
  .pp { padding: 0 var(--gutter); }
  .pp__panel { position: relative; max-width: 1360px; margin: 0 auto; border-radius: 32px; overflow: hidden; padding: clamp(56px, 8vw, 110px) clamp(24px, 5vw, 80px); }
  .pp__grid { position: relative; display: grid; gap: 48px; max-width: var(--wrap); margin: 0 auto; }
  .pp__left { display: grid; gap: 24px; align-content: start; }
  .pp__left .btn { justify-self: start; }
  .pp__steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 34px; }
  .pp__steps li { display: grid; gap: 10px; padding-left: 28px; position: relative; }
  .pp__steps li::before { content: ''; position: absolute; left: 0; top: 7px; width: 10px; height: 10px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 6px rgba(241,100,54,.2); }
  .pp__steps li::after { content: ''; position: absolute; left: 4.5px; top: 26px; bottom: -30px; width: 1px; background: var(--line-dark); }
  .pp__steps li:last-child::after { display: none; }
  .pp__n { font-size: 14px; color: var(--muted-on-dark); }
  .pp__steps h3 { font-size: clamp(1.5rem, 2.4vw, 2.1rem); }
  .pp__steps p { color: var(--muted-on-dark); max-width: 52ch; }
  .pp__objs span { position: absolute; }
  .ob { border-radius: 50%; background: radial-gradient(circle at 30% 28%, #ffd2bd 0%, #ff9a6e 28%, #f16436 60%, #a8360e 100%); box-shadow: inset -10px -14px 26px rgba(90,20,0,.45); opacity: .9; }
  .ob--1 { width: 120px; height: 120px; right: 8%; top: 8%; }
  .ob--2 { width: 60px; height: 60px; left: 42%; bottom: 10%; }
  .ob--3 { width: 34px; height: 34px; left: 6%; top: 60%; }
  .cube { width: 70px; height: 70px; border-radius: 18px; background: linear-gradient(145deg, #3a3f46, #1b1d21); box-shadow: inset 2px 2px 0 rgba(255,255,255,.08), 0 20px 40px rgba(0,0,0,.4); transform: rotate(24deg); }
  .cube--1 { right: 30%; top: 12%; } .cube--2 { left: 4%; bottom: 8%; width: 46px; height: 46px; }
  @media (max-width: 899px) { .pp__objs { display: none; } }
  @media (min-width: 980px) { .pp__grid { grid-template-columns: 1fr 1.1fr; gap: 80px; } .pp__left { position: sticky; top: 140px; align-self: start; } }
</style>
