---
import Icon3D from '../Icon3D.astro';
import type { IconName } from '../../data/types';
interface Props { items: { title: string; href: string; body: string; icon: IconName }[]; heading: string; }
const { items, heading } = Astro.props;
---
<section class="section chd">
  <div class="wrap">
    <div class="head"><p class="label" data-reveal>Services in this area</p><h2 data-reveal>{heading}</h2></div>
    <ul class="chd__grid">
      {items.map((c) => (
        <li data-reveal><a href={c.href}>
          <div class="chd__icon"><Icon3D name={c.icon} /></div>
          <h3>{c.title}</h3><p>{c.body}</p><span class="chd__go" aria-hidden="true">→</span>
        </a></li>
      ))}
    </ul>
  </div>
</section>
<style>
  .chd__grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .chd__grid a { position: relative; display: grid; gap: 12px; align-content: start; height: 100%; padding: 26px; border-radius: var(--radius); background: #f3f1ee; text-decoration: none; transition: background .4s var(--ease), transform .4s var(--ease); }
  .chd__grid a:hover { background: var(--accent-tint); transform: translateY(-6px); }
  .chd__icon { width: 60%; margin: 0 auto 6px; }
  .chd__grid p { color: var(--muted); font-size: 15px; }
  .chd__go { position: absolute; top: 22px; right: 22px; width: 38px; height: 38px; display: grid; place-items: center; border-radius: 50%; background: var(--white); transition: background .3s, color .3s, transform .4s var(--ease); }
  .chd__grid a:hover .chd__go { background: var(--accent); color: var(--white); transform: rotate(-45deg); }
  @media (min-width: 760px) { .chd__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1080px) { .chd__grid { grid-template-columns: repeat(3, 1fr); } }
</style>
