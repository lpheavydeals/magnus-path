---
const steps = [
  { t: 'Free store audit', d: 'Share your store or marketplace link. Within 24 hours you get a video walkthrough and PDF covering speed, conversion leaks, ad waste and SEO gaps.' },
  { t: '90-day growth plan', d: 'Clear targets for revenue, ROAS and rankings, the channels we will use and a fixed monthly fee. No surprises.' },
  { t: 'Build & launch', d: 'We fix or rebuild the store, restructure ad accounts and start SEO. Most brands see changes live within 2–4 weeks.' },
  { t: 'Grow & report', d: 'Weekly sales, ROAS and ranking reports, plus a monthly review call where we agree the next moves together.' },
];
---
<section class="pr" data-float-scope>
  <div class="pr__panel dark">
    <div class="pr__objs" aria-hidden="true">
      <span class="ob ob--1" data-float="-60"></span><span class="ob ob--2" data-float="80"></span><span class="ob ob--3" data-float="-120"></span>
      <span class="cube cube--1" data-float="100"></span><span class="cube cube--2" data-float="-70"></span>
    </div>
    <div class="pr__grid">
      <div class="pr__left">
        <p class="label">How it works</p>
        <h2>How we grow your online sales in <em>4 steps</em></h2>
        <a class="btn btn--primary" href="/free-ecommerce-audit/">Start with a free audit <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <ol class="pr__steps">
        {steps.map((s, i) => (
          <li data-reveal>
            <span class="pr__n">Step {i + 1}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
<style>
  .pr { padding: 0 var(--gutter); }
  .pr__panel { position: relative; max-width: 1360px; margin: 0 auto; border-radius: 32px; overflow: hidden; padding: clamp(56px, 8vw, 110px) clamp(24px, 5vw, 80px); }
  .pr__grid { position: relative; display: grid; gap: 48px; max-width: var(--wrap); margin: 0 auto; }
  .pr__left { display: grid; gap: 24px; align-content: start; }
  .pr__left .btn { justify-self: start; }
  .pr__steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 34px; }
  .pr__steps li { display: grid; gap: 10px; padding-left: 28px; position: relative; }
  .pr__steps li::before { content: ''; position: absolute; left: 0; top: 7px; width: 10px; height: 10px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 6px rgba(241,100,54,.2); }
  .pr__steps li::after { content: ''; position: absolute; left: 4.5px; top: 26px; bottom: -30px; width: 1px; background: var(--line-dark); }
  .pr__steps li:last-child::after { display: none; }
  .pr__n { font-size: 14px; color: var(--muted-on-dark); }
  .pr__steps h3 { font-size: clamp(1.5rem, 2.4vw, 2.1rem); }
  .pr__steps p { color: var(--muted-on-dark); max-width: 52ch; }
  .pr__objs span { position: absolute; }
  @media (max-width: 899px) { .pr__objs { display: none; } }
  .ob { border-radius: 50%; background: radial-gradient(circle at 30% 28%, #ffd2bd 0%, #ff9a6e 28%, #f16436 60%, #a8360e 100%); box-shadow: inset -10px -14px 26px rgba(90,20,0,.45); opacity: .9; }
  .ob--1 { width: 120px; height: 120px; right: 8%; top: 8%; }
  .ob--2 { width: 60px; height: 60px; left: 42%; bottom: 10%; }
  .ob--3 { width: 34px; height: 34px; left: 6%; top: 60%; }
  .cube { width: 70px; height: 70px; border-radius: 18px; background: linear-gradient(145deg, #3a3f46, #1b1d21); box-shadow: inset 2px 2px 0 rgba(255,255,255,.08), 0 20px 40px rgba(0,0,0,.4); transform: rotate(24deg); }
  .cube--1 { right: 30%; top: 12%; } .cube--2 { left: 4%; bottom: 8%; width: 46px; height: 46px; }
  @media (min-width: 980px) { .pr__grid { grid-template-columns: 1fr 1.1fr; gap: 80px; } .pr__left { position: sticky; top: 140px; align-self: start; } }
</style>
