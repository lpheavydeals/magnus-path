---
import Base from '../layouts/Base.astro';
import SimpleHero from '../components/page/SimpleHero.astro';
import Tiers from '../components/page/Tiers.astro';
import Guide from '../components/page/Guide.astro';
import FAQ from '../components/FAQ.astro';
import Related from '../components/page/Related.astro';
import LeadForm from '../components/LeadForm.astro';
import { seoTiers } from '../data/pricing';
import { breadcrumbSchema, faqSchema } from '../data/schema';
const trail = [{ label: 'SEO', href: '/ecommerce-seo/' }, { label: 'SEO Services', href: '/seo-services/' }];
const guide = [
  { heading: 'How much does SEO cost in India?', paragraphs: ['SEO cost in India ranges widely. Freelancers usually charge less, while agencies typically charge ₹25,000 to ₹1,50,000 a month or more for competitive industries. The difference is usually in what is actually delivered each month: technical fixes, content, links and reporting.', 'Our SEO packages start at ₹25,000 a month for local businesses, ₹45,000 a month for businesses competing across India and ₹80,000 a month for competitive industries and multi-location brands. All prices exclude GST.'] },
  { heading: 'What affects SEO charges', paragraphs: ['Three things drive SEO charges more than anything else: how competitive your keywords are, how large your website is, and how much content and authority you already have. A dental clinic targeting one area of Chennai needs far less work than a national brand competing for searches with thousands of monthly visits.'], bullets: ['Competition: who already ranks on page one and how strong their sites are', 'Scope: number of locations, pages and target keywords', 'Starting point: technical health, existing content and backlinks', 'Speed: how quickly you want to grow, which sets the monthly content volume'] },
  { heading: 'Cheap SEO packages: what to watch out for', paragraphs: ['Very low-priced SEO packages often rely on bulk directory submissions, spun articles and purchased links. These can produce a short spike and then lead to ranking drops when Google discounts or penalises the links. Ask any SEO provider exactly what they will do each month, which pages they will improve and how they build links.'] },
  { heading: 'Local SEO vs national SEO packages', paragraphs: ['Local SEO focuses on appearing in Google Maps and “near me” searches in one city: Google Business Profile, reviews, local citations and location pages. National SEO targets searches across India and needs more content and authority. Our Local package suits clinics, showrooms, schools and service businesses; Growth and Authority suit brands and B2B companies selling across India or abroad.'] },
  { heading: 'What results to expect and when', paragraphs: ['Local rankings often improve within 6–12 weeks once Google Business Profile and on-page fixes are done. National rankings for competitive keywords typically take 4–8 months. You will see monthly or fortnightly reports with rankings, traffic, leads and the work completed, so progress is visible from the first month.'] },
];
const faqs = [
  { q: 'What is the cost of SEO in India per month?', a: 'SEO in India typically costs ₹25,000 to ₹1,50,000 a month with an agency, depending on competition and scope. Magnus Path’s SEO packages start at ₹25,000 a month for local SEO, ₹45,000 for national growth and ₹80,000 for competitive industries, excluding GST.' },
  { q: 'Which SEO package should I choose?', a: 'Choose Local if most of your customers are in one city, Growth if you sell across India, and Authority if your industry is very competitive or you have several locations. We recommend the right plan after a free audit of your website.' },
  { q: 'Are SEO charges in India lower than abroad?', a: 'Usually, yes. Indian agencies can deliver the same technical and content work at a lower monthly cost than agencies in the UK, USA or Australia, which is why many overseas businesses outsource SEO to India.' },
  { q: 'Do your SEO packages include content writing?', a: 'Yes. Growth includes three content pieces a month and Authority includes six, written by our team and optimised for your target keywords. The Local package focuses on Google Business Profile and on-page improvements.' },
  { q: 'How long is the SEO contract?', a: 'There is an initial 3-month period, after which the package runs month to month with 30 days’ notice. Three months is the minimum time needed to see SEO direction clearly.' },
  { q: 'Do you guarantee first-page rankings?', a: 'No honest SEO provider can guarantee rankings, because Google controls them. We commit to the work, the targets and transparent reporting, and we show progress on rankings, traffic and leads every month.' },
];
const schema = [breadcrumbSchema([...trail, { label: 'SEO Packages', href: '/seo-packages/' }]), faqSchema(faqs)];
---
<Base title="SEO Packages India: Plans & SEO Cost | Magnus Path" description="SEO packages in India from ₹25,000/month. Compare local, national and authority SEO plans and see what SEO really costs in India, with no long lock-ins." schema={schema}>
  <SimpleHero eyebrow="SEO packages India" h1="SEO Packages in India With *Clear Monthly Pricing*" intro="Compare our SEO packages for local businesses, national brands and competitive industries, and see what SEO really costs in India. Every plan lists exactly what we deliver each month, so you know what you are paying for." trail={trail} current="SEO Packages" />
  <Tiers tiers={seoTiers} heading="Choose your SEO package" note="All plans start with a free website audit. Prices exclude GST." />
  <Guide sections={guide} title="SEO cost in India: a straight answer" />
  <FAQ items={faqs} title="SEO pricing questions" />
  <Related links={[{ label: 'SEO services in India', href: '/seo-services/' }, { label: 'SEO company in Chennai', href: '/chennai/seo-company/' }, { label: 'E-commerce SEO packages', href: '/ecommerce-seo-packages/' }, { label: 'Outsource SEO to India', href: '/seo-outsourcing-india/' }]} />
  <LeadForm heading="Get your SEO quote" />
</Base>
