---
interface Props { guides: { href: string; title: string; summary: string; minutes: number }[]; heading?: string }
const { guides, heading = 'Guides on this topic' } = Astro.props;
---
<section class="rg">
  <div class="wrap">
    <p class="label">{heading}</p>
    <ul>
      {guides.map((g) => (
        <li>
          <a href={g.href}>
            <span class="rg__meta">Guide · {g.minutes} min read</span>
            <strong>{g.title}</strong>
            <span class="rg__sum">{g.summary}</span>
            <span class="rg__go">Read the guide <span aria-hidden="true">→</span></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .rg { padding: clamp(40px, 6vw, 72px) 0 0; }
  .rg ul { list-style: none; margin: 18px 0 0; padding: 0; display: grid; gap: 16px; }
  .rg a { display: grid; gap: 10px; align-content: start; height: 100%; padding: 26px; border-radius: 24px; background: var(--white); border: 1px solid var(--line); text-decoration: none; transition: transform .4s var(--ease), box-shadow .4s var(--ease); }
  .rg a:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .rg__meta { font-size: 13px; color: var(--muted); }
  .rg strong { font-family: var(--font-display); font-weight: 600; letter-spacing: -0.02em; font-size: 1.2rem; line-height: 1.25; }
  .rg__sum { color: var(--muted); font-size: 15px; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .rg__go { color: var(--accent-ink); font-weight: 600; font-size: 15px; }
  @media (min-width: 900px) { .rg ul { grid-template-columns: repeat(3, 1fr); } }
</style>
