---
interface Props { items: { title: string; body: string }[]; heading: string; platforms?: string[]; }
const { items, heading, platforms = [] } = Astro.props;
---
<section class="section inc">
  <div class="wrap">
    <div class="inc__head">
      <div class="head"><p class="label" data-reveal>What's included</p><h2 data-reveal>{heading}</h2></div>
      {platforms.length > 0 && <ul class="inc__plat" data-reveal>{platforms.map((p) => <li>{p}</li>)}</ul>}
    </div>
    <ol class="inc__grid">
      {items.map((it, i) => (
        <li data-reveal>
          <span class="inc__n">{String(i + 1).padStart(2, '0')}</span>
          <h3>{it.title}</h3>
          <p>{it.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .inc { background: var(--white); }
  .inc__head { display: grid; gap: 24px; align-items: end; margin-bottom: clamp(36px, 5vw, 60px); }
  .inc__head .head { margin: 0; }
  .inc__plat { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .inc__plat li { font-size: 13.5px; padding: 7px 13px; border-radius: 999px; background: var(--accent-tint); color: var(--accent-ink); font-weight: 500; }
  .inc__grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; border-top: 1px solid var(--line); }
  .inc__grid li { display: grid; gap: 10px; padding: 28px 0; border-bottom: 1px solid var(--line); }
  .inc__n { font-size: 13px; color: var(--accent-ink); font-weight: 600; }
  .inc__grid h3 { font-size: 1.35rem; }
  .inc__grid p { color: var(--muted); max-width: 60ch; }
  @media (min-width: 900px) {
    .inc__head { grid-template-columns: 1.2fr 1fr; gap: 48px; }
    .inc__grid { grid-template-columns: 1fr 1fr; column-gap: 56px; }
    .inc__grid li { grid-template-columns: 44px 1fr; column-gap: 14px; }
    .inc__grid li h3, .inc__grid li p { grid-column: 2; }
    .inc__n { grid-row: 1; padding-top: 6px; }
  }
</style>
